<div class="<%= wrapper_classes %>" <%= tag.attributes(wrapper_attributes) %>>
  <%= trigger if trigger? %>

  <div
    id="<%= menu_id %>"
    role="menu"
    aria-orientation="vertical"
    data-menu-target="panel"
    data-menu-hidden-class="tw:hidden"
    class="<%= panel_classes %>"
  >
    <% entries.each do |entry| %>
      <%= entry %>
    <% end %>
  </div>
</div>

<div>
  <label class="<%= wrapper_classes %>">
    <%= tag.input(**input_tag_attributes) %>
    <div class="tw:select-none">
      <span class="<%= label_classes %>"><%= content? ? content : label %></span>
      <% if hint? %>
        <p id="<%= hint_id %>" class="tw:text-xs tw:text-gray-500 tw:mt-0.5"><%= hint %></p>
      <% end %>
    </div>
  </label>

  <% if error? %>
    <p id="<%= error_id %>" class="tw:mt-1 tw:text-xs tw:text-red-600 tw:flex tw:items-center tw:gap-1">
      <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
      <%= error %>
    </p>
  <% end %>
</div>

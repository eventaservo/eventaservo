<article class="event-card mb-3 <%= helpers.event_color_class(event) %>">
  <div class="event-card__header">
    <span class="event-card__date">
      <%= event.start_time_label(horzono: (helpers.cookies[:horzono] || event.time_zone)) unless (event.multtaga? or event.tuttaga?) %>
      <%= date_label %>
    </span>
  </div>
  <h3 class="event-card__title">
    <%= helpers.event_flag(event) %>
    <% titolo = event.title %>
    <% titolo = "🔥 #{titolo}" if event.participants.size > Constants::FAJRA_EVENTO_PARTOPRENONTOJ %>
    <%= link_to titolo, event_path(code: event.ligilo), class: ["stretched-link", ("cancelled" if event.cancelled)] %>
  </h3>
  <div class="event-card__tags">
    <%= render "events/international_badge", event: %>
    <%= helpers.display_event_tags(event) %>
  </div>
  <p class="event-card__description"><%= event.description %></p>
  <div class="event-card__details">
    <div class="event-card__detail">
      <i class="fas <%= event.universala? ? 'fa-globe' : 'fa-map-marker-alt' %>" aria-hidden="true"></i>
      <% if event.universala? %>
        <span><%= t("events.online_event") %></span>
      <% else %>
        <span><%= link_to event.city, events_by_city_path(continent: event.country.continent, country_name: event.country.name, city_name: event.city) %>, <%= link_to event.country.name, events_by_country_path(continent: event.country.continent, country_name: event.country.name) %></span>
      <% end %>
    </div>
    <% if event.organizations.any? %>
      <div class="event-card__detail">
        <i class="far fa-building" aria-hidden="true"></i>
        <span><%= link_to event.organizations.first.name, organization_url(short_name: event.organizations.first.short_name) %><%= " +#{event.organizations.size - 1}" if event.organizations.size > 1 %></span>
      </div>
    <% end %>
  </div>
</article>

<%= turbo_frame_tag "past_events_tab" do %>
  <% if @past_events.any? %>
    <div class="tw:divide-y tw:divide-gray-200 tw:border-t tw:border-b tw:border-gray-200">
      <% @past_events.each do |e| %>
        <%= link_to event_path(code: e.ligilo), class: "tw:flex tw:items-center tw:gap-3 tw:px-2 tw:py-2 tw:text-xs tw:text-gray-900 tw:no-underline tw:hover:bg-gray-100 tw:transition-colors", data: { turbo_frame: "_top" } do %>
          <div class="tw:w-5/12 tw:shrink-0 tw:truncate"><%= event_flag e %> <%= e.city %> - <%= format_date(e.date_start, style: :short) %></div>
          <div class="tw:flex-1 tw:min-w-0 <%= "tw:line-through tw:text-gray-500" if e.cancelled %>">
            <%= e.title %>
            <%= icon("fas", "camera", class: "tw:text-purple-600 tw:ml-1", title: t("organizations.tabs.has_reports")) if e.reports.any? %>
          </div>
          <i class="fas fa-chevron-right tw:text-gray-400 tw:text-[10px] tw:shrink-0" aria-hidden="true"></i>
        <% end %>
      <% end %>
    </div>
    <div class="tw:mt-3">
      <%= render "shared/pagination", pagy: @pagy %>
    </div>
  <% else %>
    <p class="tw:text-gray-500 tw:text-xs tw:text-center tw:py-6 tw:mb-0"><%= t("organizations.tabs.no_past_events") %></p>
  <% end %>
<% end %>

<% label_classes = "tw:block tw:text-sm tw:font-medium tw:text-gray-700 tw:mb-1" %>

<div class="tw:max-w-3xl tw:mx-auto">
  <%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
    <% panel.with_body do %>
      <h1 class="tw:text-xl tw:font-light tw:text-gray-900 tw:pb-3 tw:mb-4 tw:border-b tw:border-gray-200 tw:mt-0">
        <% if params[:action] == "new" %>
          <%= t("organizations.form.new_title") %>
        <% else %>
          <%= t("organizations.form.edit_title") %>
        <% end %>
      </h1>

      <%= form_for(@organizo, url: (organization_url(short_name: @organizo.short_name) if params[:action].in? %w[edit update])) do |f| %>
        <%= error_handling(@organizo) %>

        <div class="tw:mb-3">
          <%= render Ui::InputComponent.new(
            f.field_name(:name),
            id: f.field_id(:name),
            value: @organizo.name,
            label: t("common.name"),
            autofocus: true,
            required: true
          ) %>
        </div>

        <div class="tw:mb-3">
          <%= render Ui::InputComponent.new(
            f.field_name(:short_name),
            id: f.field_id(:short_name),
            value: @organizo.short_name,
            label: t("organizations.form.short_name"),
            hint: t("organizations.form.short_name_help"),
            required: true,
            "aria-describedby": "short_name_help"
          ) %>
        </div>

        <div class="tw:mb-3">
          <%= hidden_field_tag f.field_name(:display_flag), "0", id: nil %>
          <%= render Ui::CheckboxComponent.new(
            f.field_name(:display_flag),
            id: f.field_id(:display_flag),
            checked: @organizo.display_flag,
            label: t("organizations.form.display_flag"),
            hint: t("organizations.form.display_flag_help"),
            "aria-describedby": "display_flag_help"
          ) %>
        </div>

        <div class="tw:grid tw:grid-cols-1 tw:md:grid-cols-2 tw:gap-3 tw:mb-3">
          <div>
            <%= render Ui::InputComponent.new(
              f.field_name(:url),
              id: f.field_id(:url),
              value: @organizo.url,
              label: t("organizations.form.url")
            ) %>
          </div>
          <div>
            <%= render Ui::InputComponent.new(
              f.field_name(:youtube),
              id: f.field_id(:youtube),
              value: @organizo.youtube,
              label: t("organizations.form.youtube")
            ) %>
          </div>
        </div>

        <div class="tw:grid tw:grid-cols-1 tw:md:grid-cols-2 tw:gap-3 tw:mb-3">
          <div>
            <%= render Ui::InputComponent.new(
              f.field_name(:email),
              id: f.field_id(:email),
              type: :email,
              value: @organizo.email,
              label: t("organizations.form.email")
            ) %>
          </div>
          <div>
            <%= render Ui::InputComponent.new(
              f.field_name(:phone),
              id: f.field_id(:phone),
              value: @organizo.phone,
              label: t("organizations.form.phone")
            ) %>
          </div>
        </div>

        <div class="tw:mb-3">
          <%= render Ui::InputComponent.new(
            f.field_name(:address),
            id: f.field_id(:address),
            value: @organizo.address,
            label: t("organizations.form.address")
          ) %>
        </div>

        <div class="tw:grid tw:grid-cols-1 tw:md:grid-cols-2 tw:gap-3 tw:mb-3">
          <div>
            <%= render Ui::InputComponent.new(
              f.field_name(:city),
              id: f.field_id(:city),
              value: @organizo.city,
              label: t("organizations.form.city")
            ) %>
          </div>
          <div>
            <%= f.label :country_id, t("common.country"), class: label_classes %>
            <%= f.combobox("country_id", Country.all, placeholder: t("common.country"), required: true) %>
          </div>
        </div>

        <div class="tw:mb-4">
          <%= f.label :description, t("organizations.form.description"), class: label_classes %>
          <%= f.rich_text_area :description, class: "tw:block tw:w-full tw:min-h-48 tw:max-h-96 tw:overflow-y-auto tw:rounded-[3px] tw:border tw:border-gray-300 tw:bg-white tw:p-2 tw:text-sm" %>
        </div>

        <div class="tw:mb-4">
          <div class="text-divider tw:font-medium tw:text-gray-700 tw:mb-3"><%= t("organizations.form.logo") %></div>
          <% if @organizo.logo.attached? && @organizo.logo.blob&.persisted? %>
            <div class="tw:flex tw:flex-col tw:items-center tw:justify-center tw:gap-2 tw:mb-3">
              <%= organization_logo(@organizo, size: :large) %>
              <%= render Ui::CheckboxComponent.new(
                :delete_logo,
                id: "delete_logo",
                value: "true",
                checked: false,
                label: t("organizations.form.delete_logo"),
                hint: t("organizations.form.delete_logo_help")
              ) %>
            </div>
          <% end %>
          <%= f.file_field :logo,
            accept: Organization::ACCEPTED_LOGO_CONTENT_TYPES.join(","),
            class: "tw:block tw:w-full tw:text-sm tw:text-gray-700 tw:border tw:border-gray-300 tw:rounded tw:bg-white tw:px-2.5 tw:py-1.5 tw:file:mr-3 tw:file:py-1 tw:file:px-2.5 tw:file:rounded tw:file:border tw:file:border-gray-300 tw:file:text-xs tw:file:font-medium tw:file:bg-gray-100 tw:file:text-gray-700 tw:hover:file:bg-gray-200" %>
        </div>

        <div class="tw:flex tw:items-center tw:justify-end tw:gap-2 tw:pt-3 tw:mt-5 tw:border-t tw:border-gray-200">
          <%= render Ui::ButtonComponent.new(t("buttons.cancel"), href: organizations_url, variant: :cancel) %>
          <%= render Ui::ButtonComponent.new(t("buttons.save"), variant: :primary, type: :submit) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>

<div class="row">
  <div class="col-lg-8 offset-lg-2">
    <div class="box-white">
      <div class="lead">
        <% if params[:action] == 'new' %>
          <%= t("organizations.form.new_title") %>
        <% else %>
          <%= t("organizations.form.edit_title") %>
        <% end %>
      </div>
      <%= form_for(@organizo, url: (organization_url(short_name: @organizo.short_name) if params[:action].in? %w(edit update))) do |f| %>
        <%= error_handling(@organizo) %>
        <div class="mb-3">
          <%= f.label :name, t("common.name") %>
          <%= f.text_field :name, class: 'form-control', autofocus: true, required: true %>
        </div>
        <div class="mb-3">
          <%= f.label :short_name, t("organizations.form.short_name") %>
          <%= f.text_field :short_name, class: 'form-control', required: true, aria: { describedby: 'short_name_help' } %>
          <small id="short_name_help" class="form-text text-muted"><%= t("organizations.form.short_name_help") %></small>
        </div>
        <div class="mb-3 form-check">
          <%= f.check_box :display_flag, class: 'form-check-input', aria: { describedby: 'display_flag_help' } %>
          <%= f.label :display_flag, t("organizations.form.display_flag"), class: 'form-check-label' %>
          <small id="display_flag_help" class="form-text text-muted"><%= t("organizations.form.display_flag_help") %></small>
        </div>
        <div class="row">
          <div class="mb-3 col-12 col-md-6">
            <%= f.label :url, t("organizations.form.url") %>
            <%= f.text_field :url, class: 'form-control' %>
          </div>
          <div class="mb-3 col-12 col-md-6">
            <%= f.label :youtube, t("organizations.form.youtube") %>
            <%= f.text_field :youtube, class: 'form-control' %>
          </div>
        </div>
        <div class="row">
          <div class="mb-3 col-12 col-md-6">
            <%= f.label :email, t("organizations.form.email") %>
            <%= f.text_field :email, class: 'form-control', type: 'email' %>
          </div>
          <div class="mb-3 col-12 col-md-6">
            <%= f.label :phone, t("organizations.form.phone") %>
            <%= f.text_field :phone, class: 'form-control' %>
          </div>
        </div>
        <div class="mb-3">
          <%= f.label :address, t("organizations.form.address") %>
          <%= f.text_field :address, class: 'form-control' %>
        </div>
        <div class="row">
          <div class="mb-3 col-12 col-md-6">
            <%= f.label :city, t("organizations.form.city") %>
            <%= f.text_field :city, class: 'form-control' %>
          </div>
          <div class="mb-3 col-12 col-md-6">
            <%= f.label :country_id, t("common.country") %>
            <%= f.combobox("country_id", Country.all, placeholder: t("common.country"), required: true)%>
          </div>
        </div>
        <div class="mb-3">
          <%= f.label :description, t("organizations.form.description") %>
          <%= f.rich_text_area :description, class: 'form-control', style: 'height: 15em; overflow-y: auto;' %>
        </div>
        <div class="mb-3">
          <div class="text-divider"><%= t("organizations.form.logo") %></div>
          <br>
          <% if @organizo.logo.attached? %>
            <div class="d-flex flex-column align-items-center justify-content-center">
              <%= organization_logo(@organizo, size: :large) %>
              <div class="form-check">
                <%= check_box_tag :delete_logo, true, false, class: 'form-check-input' %>
                <%= label_tag 'delete_logo', t("organizations.form.delete_logo"), class: 'form-check-label' %>
                <p><%= t("organizations.form.delete_logo_help") %></p>
              </div>
            </div>
          <% end %>
          <%= f.file_field :logo, class: 'form-control', accept: 'image/gif,image/jpeg,image/png' %>
        </div>
        <div class="buttons-footer">
          <%= link_to t("buttons.cancel"), organizations_url, class: 'button-cancel' %>
          <%= f.submit t("buttons.save"), class: 'button-submit' %>
        </div>
      <% end %>
    </div>
  </div>
</div>

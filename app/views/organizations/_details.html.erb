<div class="box-white">
  <div class="lead">
    <%= display_flag(@organizo.country) if @organizo.country.present? && @organizo.display_flag? %>
    <%= @organizo.name %>
    <span class="float-end">
      <%= link_to icon('far', 'calendar-alt'),
        webcal_organizo_url(short_name: @organizo.short_name, protocol: :webcal, format: :ics),
        data: { bs_target: '#webcalModal', bs_toggle: 'modal' },
        aria: { label: t("organizations.details.subscribe_calendar") } %>
    </span>
  </div>

  <div class="clearfix mb-2">
    <%= organization_logo(@organizo, size: :large, html_class: 'float-start me-2') %>
    <%= @organizo.description %>
  </div>

  <p class="small">
    <%= phone_link(@organizo.phone) + raw('<br/>') if @organizo.phone.present? %>
    <%= link_to_website(@organizo.url) + raw('<br/>') if @organizo.url.present? %>
    <%= display_email(@organizo.email) + raw('<br/>') if @organizo.email.present? %>
    <% if @organizo.youtube.present? %>
      <%= link_to icon('fab', 'youtube', t("organizations.details.youtube_channel")), @organizo.youtube, target: :_blank, class: 'fg-color-link me-1' %>
      <br>
    <% end %>
    <% if @organizo.country.present? && (@organizo.country_id != 99999) %>
      <%= address_link(@organizo.full_address) %>
    <% end %>
  </p>

  <% if user_signed_in? && current_user.admin_of?(@organizo) %>
    <div class="buttons-footer">
      <%= link_to icon('far', 'edit', t("buttons.edit")), edit_organization_url(short_name: @organizo.short_name), class: 'btn btn-sm btn-outline-primary no-border' %>
    </div>
  <% end %>
</div>

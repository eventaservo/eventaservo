<div class="es-list__headers align-items-center">
  <div class="col-8 col-lg-10"><%= t("common.name") %></div>
  <div class="col-2 col-lg-1">
    <%= render Ui::TooltipComponent.new(text: t("common.events"), placement: :top) do %>
      <i class="far fa-calendar" aria-hidden="true"></i>
    <% end %>
  </div>
  <div class="col-2 col-lg-1">
    <%= render Ui::TooltipComponent.new(text: t("organizations.index.admins_and_helpers_tooltip"), placement: :top) do %>
      <i class="fas fa-users" aria-hidden="true"></i>
    <% end %>
  </div>
</div>

<% @organizoj.each do |organizo| %>
  <%= render partial: 'organization_card', locals: { organizo: organizo } %>
<% end %>

<% if @organizoj.size.zero? %>
  <div class="text-center">
    <%= t("common.no_results") %>
  </div>
<% end %>

<%= render "shared/pagination", pagy: @pagy %>

<%= link_to organization_url(short_name: organizo.short_name), class: "tw:grid tw:grid-cols-12 tw:items-center tw:gap-2 tw:px-2 tw:py-3 tw:text-sm tw:text-gray-900 tw:no-underline tw:border-b tw:border-gray-200 tw:hover:bg-gray-100 tw:transition-colors" do %>
  <div class="tw:col-span-2 tw:lg:col-span-1 tw:flex tw:justify-center">
    <%= organization_logo(organizo, size: :medium) %>
  </div>
  <div class="tw:col-span-6 tw:lg:col-span-9 tw:min-w-0 tw:break-words">
    <%= organizo.name %>
  </div>
  <div class="tw:col-span-2 tw:lg:col-span-1 tw:text-center">
    <%= organizo.eventoj.count %>
  </div>
  <div class="tw:col-span-2 tw:lg:col-span-1 tw:text-center">
    <%= organizo.uzantoj.count %>
  </div>
<% end %>

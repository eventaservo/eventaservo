<% content_for :title do %>
  <%= @organizo.name %>
<% end %>

<%= render "organization_meta" %>

<% show_sidebar = organization_show_sidebar?(params) %>

<div class="tw:grid tw:grid-cols-1 <%= "tw:lg:grid-cols-12" if show_sidebar %> tw:gap-4">
  <div id="organization_main_column" class="<%= show_sidebar ? "tw:lg:col-span-8" : "tw:col-span-1" %> tw:space-y-4">
    <%= render "details" %>
    <%= render "tabs" %>
  </div>

  <% if show_sidebar %>
    <div id="organization_admin_sidebar" class="tw:lg:col-span-4">
      <%= render partial: "uzantoj" %>
    </div>
  <% end %>
</div>

<%= render "webcal_modal" %>

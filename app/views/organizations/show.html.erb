<% content_for :title do %>
  <%= @organizo.name %>
<% end %>

<%= render "organization_meta" %>

<% show_sidebar = organization_show_sidebar?(params) %>

<div class="row">
  <div class="<%= show_sidebar ? "col-lg-8" : "col-12" %>">
    <%= render "details" %>
    <%= render "tabs" %>
  </div>

  <% if show_sidebar %>
    <div class="col-lg-4">
      <%= render partial: "uzantoj" %>
    </div>
  <% end %>
</div>

<%= render "webcal_modal" %>

<% content_for :title do %>
  <%= @organizo.name %>
<% end %>

<%= render 'organization_meta' %>

<div class="row">
  <div class="col-lg-8">
    <div class="box-white">
      <div class="lead">
        <%= display_flag(@organizo.country) if @organizo.country.present? && @organizo.display_flag? %>
        <%= @organizo.name %>
        <span class="float-end">
          <%= link_to icon('far', 'calendar-alt'),
            webcal_organizo_url(short_name: @organizo.short_name, protocol: :webcal, format: :ics),
            data: { bs_target: '#webcalModal', bs_toggle: 'modal' },
            aria: { label: 'Aboni organizan kalendaron' } %>
        </span>
      </div>

      <div class="clearfix mb-2">
        <%= organization_logo(@organizo, size: :large, html_class: 'float-start me-2') %>
        <%= @organizo.description %>
      </div>

      <p class="small">
        <%= phone_link(@organizo.phone) + raw('<br/>') if @organizo.phone.present? %>
        <%= link_to_website(@organizo.url) + raw('<br/>') if @organizo.url.present? %>
        <%= display_email(@organizo.email) + raw('<br/>') if @organizo.email.present? %>
        <% if @organizo.youtube.present? %>
          <%= link_to icon('fab', 'youtube', 'YouTube-kanalo'), @organizo.youtube, target: :_blank, class: 'fg-color-link me-1' %>
          <br>
        <% end %>
        <% if @organizo.country.present? && (@organizo.country_id != 99999) %>
          <%= address_link(@organizo.full_address) %>
        <% end %>
      </p>

      <% if user_signed_in? && current_user.admin_of?(@organizo) %>
        <div class="buttons-footer">
          <%= link_to icon('far', 'edit', 'Redakti'), edit_organization_url(@organizo.short_name), class: 'btn btn-sm btn-outline-primary no-border' %>
        </div>
      <% end %>
    </div>

    <%
      active_tab = if %w[future past reports].include?(params[:tab].to_s)
        params[:tab].to_sym
      elsif params[:venontaj_pagho].present?
        :future
      elsif params[:raportoj_pagho].present?
        :reports
      elsif params[:pagho].present? || params[:page].present?
        :past
      elsif @future_events.any?
        :future
      elsif @past_events.any?
        :past
      else
        :reports
      end
    %>

    <div class="box-white">
      <ul class="nav nav-tabs org-tabs mb-3" id="orgTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link <%= 'active' if active_tab == :future %>" id="future-tab" data-bs-toggle="tab" data-bs-target="#future-tab-pane" type="button" role="tab" aria-controls="future-tab-pane" aria-selected="<%= active_tab == :future %>">
            Venontaj <span class="d-none d-sm-inline">eventoj</span>
            <span class="badge rounded-pill text-bg-secondary ms-1"><%= @pagy_future.count %></span>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link <%= 'active' if active_tab == :past %>" id="past-tab" data-bs-toggle="tab" data-bs-target="#past-tab-pane" type="button" role="tab" aria-controls="past-tab-pane" aria-selected="<%= active_tab == :past %>">
            Pasintaj <span class="d-none d-sm-inline">eventoj</span>
            <span class="badge rounded-pill text-bg-secondary ms-1"><%= @pagy.count %></span>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link <%= 'active' if active_tab == :reports %>" id="reports-tab" data-bs-toggle="tab" data-bs-target="#reports-tab-pane" type="button" role="tab" aria-controls="reports-tab-pane" aria-selected="<%= active_tab == :reports %>">
            📸 Raportoj
            <span class="badge rounded-pill text-bg-secondary ms-1"><%= @pagy_reports.count %></span>
          </button>
        </li>
      </ul>

      <div class="tab-content" id="orgTabsContent">
        <div class="tab-pane fade <%= 'show active' if active_tab == :future %>" id="future-tab-pane" role="tabpanel" aria-labelledby="future-tab" tabindex="0">
          <%= render "future_events_tab" %>
        </div>

        <div class="tab-pane fade <%= 'show active' if active_tab == :past %>" id="past-tab-pane" role="tabpanel" aria-labelledby="past-tab" tabindex="0">
          <%= render "past_events_tab" %>
        </div>

        <div class="tab-pane fade <%= 'show active' if active_tab == :reports %>" id="reports-tab-pane" role="tabpanel" aria-labelledby="reports-tab" tabindex="0">
          <%= render "reports_tab" %>
        </div>
      </div>
    </div>
  </div>

  <% unless params['iframe'] %>
    <div class="col-lg-4">
      <%= render partial: 'uzantoj' %>
    </div>
  <% end %>
</div>

<div id="webcalModal" class="modal fade" aria-hidden="true" aria-labelledby="shareModalCenterTitle" role="dialog" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 id="shareModalCenterTitle" class="modal-title">Aboni organizan kalendaron</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermi"></button>
      </div>
      <div class="modal-body">
        <p>
          Kiam oni abonas organizan kalendaron, ĉiuj eventoj estas aldonataj al la kalendaro kaj ajnaj eventaj ŝanĝoj
          aŭtomate ĝisdatiĝas.
        </p>
        <p>
          Jen Webcal-ligilo por aboni la kalendaron de eventoj de <%= @organizo.short_name %>.
          Uzu ĝin en programoj kiel Google Calendar, iCal aŭ similaj. Se vi bezonas klarigon kiel uzi la ligilon, legu
          <%= link_to 'ĉi tiun artikolon', 'https://github.com/eventaservo/eventaservo/wiki/Webcal-(Google-Calendar---iCal)', target: :'_blank' %>.
        </p>
        <div class="input-group" data-controller="clipboard">
          <%= link_to 'Kopii', '#', class: 'input-group-text', data: { action: 'click->clipboard#copy' } %>
          <%= text_field_tag nil, webcal_organizo_url(short_name: @organizo.short_name, format: :ics), readonly: true, class: 'form-control bg-color-white', data: { clipboard_target: 'source' } %>
        </div>
        <br>
        <p>
          Kelkaj kalendaraj programoj ebligas aŭtomate aboni la kalendaron se oni alklakas specifan ligilon. Vi povas
          provi tion per <%= link_to 'ĉi tiu ligilo', webcal_organizo_url(short_name: @organizo.short_name, protocol: :webcal, format: :ics) %>.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Fermi</button>
      </div>
    </div>
  </div>
</div>

<div class="box-white">
  <div class="box-header"><%= t("organizations.users.administrators_header") %></div>
  <div class="box-body">
    <div class="text-divider"><%= t("organizations.users.head_administrators") %></div>

    <p class="bg-color-grayLighter p-1 mt-2 text-center" style="border-radius: 5px;">
      <%= t("organizations.users.head_admin_permission_info") %>
    </p>

    <% @organizo.admins.order(:name).each do |u| %>
      <br>
      <%= link_to display_user(u), events_by_username_path(username: u.username) %>
      <% if user_signed_in? && current_user.admin_of?(@organizo) %>
        <%= link_to icon('fas', 'star', class: 'fg-color-yellow'), organization_estrighu_url(organization_short_name: @organizo.short_name, username: u.username), method: :patch, aria: { label: t("organizations.users.make_head_admin") } %>
      <% else %>
        <%= icon('fas', 'star', class: 'fg-color-yellow') %>
      <% end %>
      <br>
    <% end %>

    <br>
    <br>
    <div class="text-divider"><%= t("organizations.users.co_administrators") %></div>
    <% @organizo.non_administrators.order(:name).each do |u| %>
      <br>
      <%= link_to display_user(u), events_by_username_path(username: u.username) %>

      <% if user_signed_in? && current_user.admin_of?(@organizo) %>
        <%= link_to icon('far', 'star', class: 'fg-color-gray'), organization_estrighu_url(organization_short_name: @organizo.short_name, username: u.username), method: :patch, aria: { label: t("organizations.users.make_co_admin") } %>
        <%= link_to icon('fas', 'minus-circle', class: 'fg-color-red'),
          organization_forighu_url(organization_short_name: @organizo.short_name, username: u.username),
          method: :delete,
          data: { confirm: t("organizations.users.confirm_remove_user") }, aria: { label: t("organizations.users.remove_user_from_org") } %>
      <% end %>
      <br>
    <% end %>

    <% if user_signed_in? && current_user.admin_of?(@organizo) %>
      <br>
      <br>
      <div class="text-divider"><%= t("organizations.users.add_section") %></div>
      <%= form_tag organization_aldoni_uzanton_url(organization_short_name: @organizo.short_name) do %>
        <div class="mb-3">
          <%= combobox_tag("id", combobox_users_with_username_path, placeholder: t("organizations.users.search_user_placeholder"), required: true) %>
        </div>
        <%= submit_tag t("buttons.add"), class: 'button-submit col-12' %>
      <% end %>
    <% end %>
  </div>
</div>

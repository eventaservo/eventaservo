<h4 class="tw:text-lg tw:font-medium tw:text-gray-800 tw:text-center tw:mb-3 tw:flex tw:items-center tw:justify-center tw:gap-1.5">
  <%= icon("fas", "building", t("organizations.main_organizations.title"), class: "tw:text-cyan-600") %>
</h4>

<div id="main_organizations_grid" class="tw:grid tw:grid-cols-1 tw:md:grid-cols-2 tw:gap-3">
  <% organizations.each do |organization| %>
    <%= link_to organization_url(short_name: organization.short_name), class: "tw:block tw:no-underline tw:text-inherit tw:h-full" do %>
      <%= render Ui::CardComponent.new(variant: :interactive, class: "tw:h-full tw:overflow-hidden") do |panel| %>
        <% panel.with_header(size: :small, class: "tw:bg-[#17a2b8] tw:text-white tw:text-center tw:font-medium tw:text-sm tw:border-b-0") do %>
          <%= organization.name %>
        <% end %>
        <% panel.with_body(size: :small, class: "tw:text-sm tw:text-gray-700 tw:flow-root") do %>
          <% if organization.logo.attached? %>
            <%= image_tag url_for(organization.logo), class: "tw:float-left tw:max-w-16 tw:mr-3 tw:mb-1" %>
          <% end %>

          <% description_preview = organization.description.to_plain_text.squish %>
          <%= truncate(description_preview, length: 123) if description_preview.present? %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>

<% active_tab = organization_active_tab(params, future_events: @future_events, past_events: @past_events) %>

<div class="box-white">
  <ul class="nav nav-tabs org-tabs mb-3" id="orgTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= 'active' if active_tab == :future %>" id="future-tab" data-bs-toggle="tab" data-bs-target="#future-tab-pane" type="button" role="tab" aria-controls="future-tab-pane" aria-selected="<%= active_tab == :future %>">
        <%= t("organizations.tabs.upcoming") %> <span class="d-none d-sm-inline"><%= t("organizations.tabs.events") %></span>
        <span class="badge rounded-pill text-bg-secondary ms-1"><%= @pagy_future.count %></span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= 'active' if active_tab == :past %>" id="past-tab" data-bs-toggle="tab" data-bs-target="#past-tab-pane" type="button" role="tab" aria-controls="past-tab-pane" aria-selected="<%= active_tab == :past %>">
        <%= t("organizations.tabs.past") %> <span class="d-none d-sm-inline"><%= t("organizations.tabs.events") %></span>
        <span class="badge rounded-pill text-bg-secondary ms-1"><%= @pagy.count %></span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= 'active' if active_tab == :reports %>" id="reports-tab" data-bs-toggle="tab" data-bs-target="#reports-tab-pane" type="button" role="tab" aria-controls="reports-tab-pane" aria-selected="<%= active_tab == :reports %>">
        📸 <%= t("organizations.tabs.reports") %>
        <span class="badge rounded-pill text-bg-secondary ms-1"><%= @pagy_reports.count %></span>
      </button>
    </li>
  </ul>

  <div class="tab-content" id="orgTabsContent">
    <div class="tab-pane fade <%= 'show active' if active_tab == :future %>" id="future-tab-pane" role="tabpanel" aria-labelledby="future-tab" tabindex="0">
      <%= render "future_events_tab" %>
    </div>

    <div class="tab-pane fade <%= 'show active' if active_tab == :past %>" id="past-tab-pane" role="tabpanel" aria-labelledby="past-tab" tabindex="0">
      <%= render "past_events_tab" %>
    </div>

    <div class="tab-pane fade <%= 'show active' if active_tab == :reports %>" id="reports-tab-pane" role="tabpanel" aria-labelledby="reports-tab" tabindex="0">
      <%= render "reports_tab" %>
    </div>
  </div>
</div>

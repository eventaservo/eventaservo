<% active_tab = organization_active_tab(params, future_events: @future_events, past_events: @past_events) %>

<%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
  <% panel.with_body do %>
    <%= render Ui::TabsComponent.new(id: "orgTabs", aria_label: @organizo.name) do |tabs| %>
      <% tabs.with_tab(
        id: "future",
        label: safe_join([t("organizations.tabs.upcoming"), " ", content_tag(:span, t("organizations.tabs.events"), class: "tw:hidden tw:sm:inline")]),
        count: @pagy_future.count,
        active: active_tab == :future
      ) do %>
        <%= render "future_events_tab" %>
      <% end %>

      <% tabs.with_tab(
        id: "past",
        label: safe_join([t("organizations.tabs.past"), " ", content_tag(:span, t("organizations.tabs.events"), class: "tw:hidden tw:sm:inline")]),
        count: @pagy.count,
        active: active_tab == :past
      ) do %>
        <%= render "past_events_tab" %>
      <% end %>

      <% tabs.with_tab(
        id: "reports",
        label: t("organizations.tabs.reports"),
        icon: "camera",
        count: @pagy_reports.count,
        active: active_tab == :reports
      ) do %>
        <%= render "reports_tab" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

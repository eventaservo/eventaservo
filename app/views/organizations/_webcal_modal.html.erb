<%= render Ui::ModalComponent.new(id: "webcalModal", title: t("organizations.webcal.title"), title_id: "shareModalCenterTitle", size: :lg) do |dialog| %>
  <p class="tw:mb-3">
    <%= t("organizations.webcal.description_sync") %>
  </p>
  <p class="tw:mb-3">
    <%= t("organizations.webcal.description_link_html",
          short_name: @organizo.short_name,
          article_link: link_to(t("organizations.webcal.article_link_text"), "https://github.com/eventaservo/eventaservo/wiki/Webcal-(Google-Calendar---iCal)", target: :_blank, rel: "noopener noreferrer")) %>
  </p>
  <div class="tw:flex tw:items-stretch tw:w-full" data-controller="clipboard"
       data-clipboard-success-message-value="<%= t("clipboard.copied_to_clipboard") %>"
       data-clipboard-error-message-value="<%= t("clipboard.copy_failed") %>">
    <%= link_to t("buttons.copy"), "#",
      class: "tw:inline-flex tw:items-center tw:px-3 tw:py-1.5 tw:text-sm tw:bg-gray-100 tw:border tw:border-r-0 tw:border-gray-300 tw:rounded-l-md tw:text-brand-blue tw:hover:text-brand-blue-hover tw:hover:bg-gray-200 tw:whitespace-nowrap",
      data: { action: "click->clipboard#copy" } %>
    <%= text_field_tag nil, webcal_organizo_url(short_name: @organizo.short_name, format: :ics),
      readonly: true,
      class: "tw:flex-1 tw:min-w-0 tw:px-3 tw:py-1.5 tw:text-sm tw:bg-white tw:text-gray-900 tw:border tw:border-gray-300 tw:rounded-r-md tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-brand-blue/40",
      data: { clipboard_target: "source" } %>
  </div>
  <p class="tw:mt-4 tw:mb-0">
    <%= t("organizations.webcal.auto_subscribe_html",
          link: link_to(t("organizations.webcal.link_text"), webcal_organizo_url(short_name: @organizo.short_name, protocol: :webcal, format: :ics))) %>
  </p>

  <% dialog.with_footer do %>
    <%= render Ui::ButtonComponent.new(t("buttons.close"), variant: :secondary, data: {action: "dialog#close"}) %>
  <% end %>
<% end %>

<%= render Ui::CardComponent.new(variant: :bordered, id: "evento") do |card| %>
  <% card.with_body do %>
    <h1 class="tw:text-lg tw:font-bold tw:text-gray-900 tw:border-b tw:border-gray-200 tw:pb-2 tw:mb-4">
      <%= icon("fas", "video", t("video.presentations")) %>
    </h1>
    <div class="tw:flex tw:flex-wrap tw:justify-center tw:sm:justify-start tw:gap-4">
      <%= render partial: @videoj, locals: { user: @current_user, show_event_details: true } %>
    </div>
    <div class="tw:mt-4">
      <%= render "shared/pagination", pagy: @pagy %>
    </div>
  <% end %>
<% end %>

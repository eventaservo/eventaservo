<% if interested_events.venontaj.any? %>
  <div class="tw:mb-6">
    <h5 class="tw:text-lg tw:font-light tw:text-gray-900 tw:mb-2"><%= t("users.events.interested_upcoming_events") %></h5>

    <div class="tw:border tw:border-gray-200 tw:rounded tw:overflow-hidden tw:text-xs">
      <div class="tw:grid tw:grid-cols-12 tw:items-center tw:gap-2 tw:bg-esperanto-600 tw:text-white tw:uppercase tw:font-bold tw:text-[11px] tw:px-2 tw:py-2">
        <div class="tw:col-span-3 tw:sm:col-span-2"><%= t("common.date") %></div>
        <div class="tw:col-span-6 tw:sm:col-span-7"><%= t("common.event") %></div>
        <div class="tw:col-span-3"><%= t("common.location") %></div>
      </div>

      <% venontaj = interested_events.venontaj.order(:date_start) %>
      <% venontaj.each_with_index do |event, i| %>
        <%= link_to event_path(code: event.ligilo),
              class: "tw:grid tw:grid-cols-12 tw:items-center tw:gap-2 tw:px-2 tw:py-1.5 hover-row tw:no-underline tw:text-gray-900 #{"tw:border-b tw:border-gray-200" unless i == venontaj.size - 1} #{"tw:bg-gray-50" if i.odd?}" do %>
          <div class="tw:col-span-3 tw:sm:col-span-2 tw:font-semibold tw:text-esperanto-700 tw:truncate">
            <%= format_date(event.komenca_dato, style: :compact) %>
          </div>
          <div class="tw:col-span-6 tw:sm:col-span-7 tw:font-medium tw:truncate <%= "tw:line-through tw:text-red-600" if event.cancelled %>">
            <%= event.title %>
          </div>
          <div class="tw:col-span-3 tw:text-gray-500 tw:truncate">
            <%= event_flag event %>
            <%= event.city %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

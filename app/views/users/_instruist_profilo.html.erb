<% if @uzanto.instruisto == 'true' %>
  <div class="lead"><%= t("users.profile.i_am_teacher") %></div>
  <div><%= t("users.profile.levels_taught") %></div>
  <% @uzanto.instruo['nivelo'].each do |nivelo| %>
    <div class="badge text-bg-info"><%= t("teachers_and_speakers.levels.#{nivelo}", default: nivelo.capitalize) %></div>
  <% end %>
  <br>
  <%= @uzanto.instruo['sperto'] %>
<% end %>

<% content_for :title do %>
  <%= t("international_calendar.page_title") %>
<% end %>

<% content_for :og_title do %>
  <%= t("international_calendar.page_title") %>
<% end %>

<% content_for :og_description do %>
  <%= t("international_calendar.subtitle") %>
<% end %>

<div class="box-white">
  <div class="text-center">
    <h1><%= icon("far", "calendar", t("international_calendar.title")) %></h1>
    <p>
      <%= t("international_calendar.subtitle") %><br>
      <%= t("international_calendar.missing_event_html", contact_link: mail_to("kontakto@eventaservo.org", t("international_calendar.contact_link_text"))) %>
    </p>
    <hr>
    <%= link_to t("international_calendar.past_events"), international_calendar_year_list_path, class: 'btn btn-sm btn-link' %>
  </div>

  <% @events.grouped_by_months.each do |date, events| %>
    <br>
    <h3 class="text-divider"><%= l(date, format: '%B %Y').upcase %></h3>
    <div class="row">
      <% events.each do |e| %>
        <div class="col-12">
          <%= event_flag(e) %>
          <strong><%= link_to(e.title, event_url(code: e.ligilo), class: ("cancelled" if e.cancelled)) %></strong>
          <%= display_organizations_for_event(e) %>
          <p class="small">
            <strong><%= t("events.date_in_city", date: event_date(e), city: e.city) %></strong><br>
            <%= e.description %>
          </p>
          <hr>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

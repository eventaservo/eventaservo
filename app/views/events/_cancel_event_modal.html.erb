<%= render Ui::ModalComponent.new(id: "nuligiloModal", title: t("events.cancel_modal.title"), title_id: "nuligiloModalCenterTitle", padded: false) do |dialog| %>
  <%= form_tag event_nuligi_url(event_code: @event.code), class: "tw:text-left" do %>
    <div class="<%= dialog.body_classes %> tw:font-normal tw:text-base">
      <p class="tw:mb-3"><%= t("events.cancel_modal.description") %></p>
      <div class="tw:mb-3">
        <%= render Ui::InputComponent.new(:cancel_reason, id: "cancel_reason", required: true, placeholder: t("events.cancel_modal.reason_placeholder")) %>
      </div>
    </div>

    <div class="<%= dialog.footer_classes %>">
      <%= render Ui::ButtonComponent.new(t("buttons.close"), variant: :cancel, data: {action: "dialog#close"}) %>
      <%= render Ui::ButtonComponent.new(t("events.cancel_modal.confirm_button"), variant: :danger, type: :submit) %>
    </div>
  <% end %>
<% end %>

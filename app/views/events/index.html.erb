<%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
  <% panel.with_body(class: "tw:space-y-4") do %>
    <%= page_title current_user.name %>
    <h1 class="tw:text-xl tw:font-bold tw:text-gray-900 tw:pb-2 tw:border-b tw:border-gray-200 tw:m-0"><%= t("events.my_events") %></h1>

    <div class="tw:border tw:border-gray-200 tw:rounded tw:overflow-hidden tw:text-xs">
      <div class="tw:grid tw:grid-cols-1 tw:lg:grid-cols-3 tw:gap-2 tw:bg-esperanto-500 tw:text-white tw:uppercase tw:font-bold tw:px-3 tw:py-2 tw:text-[11px]">
        <div><%= t("common.name") %></div>
        <div><%= t("common.date") %></div>
        <div><%= t("common.location") %></div>
      </div>

      <% @events.each_with_index do |event, i| %>
        <% stripe_classes = [
          ("tw:border-b tw:border-gray-200" unless i == @events.size - 1),
          ("tw:bg-gray-50" if i.odd?)
        ].compact.join(" ") %>

        <%= link_to event_path(code: event.ligilo), class: "tw:grid tw:grid-cols-1 tw:lg:grid-cols-3 tw:gap-2 tw:items-center tw:px-3 tw:py-2 tw:text-gray-900 tw:no-underline tw:hover:bg-esperanto-50 tw:transition-colors #{stripe_classes}" do %>
          <div class="tw:font-medium tw:break-words"><%= event.title %></div>
          <div class="tw:text-gray-600"><%= event_date(event) %></div>
          <div class="tw:text-gray-600 tw:break-words"><%= "#{event.city} (#{event.country.name})" %></div>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>

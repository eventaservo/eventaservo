<%= render Ui::CardComponent.new(variant: :bordered, class: "tw:mt-2 tw:border-amber-400") do |panel| %>
  <% panel.with_header(class: "tw:bg-amber-400 tw:text-gray-900 tw:text-xs tw:font-bold tw:px-3 tw:py-2") do %>
    <%= t("users.profile.admin_info.title") %>
  <% end %>

  <% panel.with_body(padding: false, class: "tw:p-3 tw:text-xs tw:space-y-1") do %>
    <div><%= display_email(uzanto.email) %></div>
    <div><%= t("users.profile.admin_info.uea_code") %>: <%= uzanto.ueacode %></div>
    <div><%= t("users.profile.admin_info.birthday") %>: <%= uzanto.birthday.strftime("%d/%m/%Y") if uzanto.birthday %></div>
    <hr class="tw:my-2 tw:border-gray-200">
    <div><%= t("users.profile.admin_info.active") %>: <%= uzanto.active? ? t("common.yes_upper") : t("common.no_upper") %></div>
    <div><%= t("users.profile.admin_info.created_at") %>: <%= uzanto.created_at.strftime("%d/%m/%Y") %></div>
    <div><%= t("users.profile.admin_info.last_sign_in_at") %>: <%= uzanto.last_sign_in_at&.strftime("%d/%m/%Y") || t("users.profile.admin_info.never") %></div>
    <hr class="tw:my-2 tw:border-gray-200">
    <div>
      <%= link_to t("users.profile.admin_info.search_in_admin"), admin_users_path(name: uzanto.name[0..3]), target: :_blank %>
    </div>
  <% end %>
<% end %>

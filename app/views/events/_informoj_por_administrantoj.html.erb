<div class="card small mt-2 border-warning">
  <div class="card-header bg-warning">
    <%= t("users.profile.admin_info.title") %>
  </div>
  <div class="card-body">
    <%= display_email(uzanto.email) %>
    <br>
    <%= t("users.profile.admin_info.uea_code") %>: <%= uzanto.ueacode %>
    <br>
    <%= t("users.profile.admin_info.birthday") %>: <%= uzanto.birthday.strftime("%d/%m/%Y") if uzanto.birthday %>
    <hr>
    <%= t("users.profile.admin_info.active") %>: <%= uzanto.active? ? t("common.yes_upper") : t("common.no_upper") %>
    <br>
    <%= t("users.profile.admin_info.created_at") %>: <%= uzanto.created_at.strftime("%d/%m/%Y") %>
    <br>
    <%= t("users.profile.admin_info.last_sign_in_at") %>: <%= uzanto.last_sign_in_at&.strftime("%d/%m/%Y") || t("users.profile.admin_info.never") %>
    <hr>
    <%= link_to t("users.profile.admin_info.search_in_admin"), admin_users_path(name: uzanto.name[0..3]), target: :_blank %>
  </div>
</div>

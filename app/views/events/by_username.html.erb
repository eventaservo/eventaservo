<div class="box-white">
  <div class="row">
    <div class="col-md-3">
      <div class="text-center">
        <%= display_user_image_profile(@uzanto) %>
      </div>
    </div>
    <div class="col-md-9">
      <div class="d-flex justify-content-between">
        <h1 class="display-4"><%= @uzanto.name %></h1>
        <% if current_user == @uzanto && @uzanto.webcal_token.present? %>
          <%= link_to icon('far', 'calendar-alt'),
            webcal_user_url(webcal_token: @uzanto.webcal_token, protocol: :webcal, format: :ics),
            data: { dialog_open: 'webcalModal' },
            aria: { label: t("users.profile.subscribe_personal_calendar") } %>
        <% end %>
      </div>

      <%= display_flag(@uzanto.country) %>
      <%= @uzanto.country.name if @uzanto.country %>
      (<%= @uzanto.city %>)
      <p class="small"><%= simple_format(@uzanto.about) %></p>
    </div>
  </div>
  <br>
  <div class="row">
    <div class="col-lg-3 col-md-12">
      <%= render 'user_social_links', user: @uzanto %>
      <br>
      <%= render partial: 'uzantaj_organizoj' %>
      <%= render partial: 'informoj_por_administrantoj', locals: { uzanto: @uzanto } if current_user&.admin? %>
    </div>
    <div class="col-lg-9 col-md-12">
      <div class="row">
        <div class="col-12 col-md-6 mb-5">
          <%= render partial: 'users/instruist_profilo' %>
        </div>
        <div class="col-12 col-md-6 mb-5">
          <%= render partial: 'users/prelegant_profilo', locals: { user: @uzanto } %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if current_user == @uzanto && @uzanto.webcal_token.present? %>
  <%= render Ui::ModalComponent.new(id: "webcalModal", title: t("users.profile.subscribe_personal_calendar"), title_id: "shareModalCenterTitle", size: :lg) do |dialog| %>
    <p>
      <%= t("users.profile.webcal_info_1") %>
    </p>
    <div class="alert alert-warning">
      <%= t("users.profile.webcal_warning") %>
    </div>
    <p>
      <%= t("users.profile.webcal_info_2_html", article_link: link_to(t("users.profile.this_article"), "https://github.com/eventaservo/eventaservo/wiki/Webcal-(Google-Calendar---iCal)", target: "_blank")) %>
    </p>
    <div class="input-group" data-controller="clipboard"
         data-clipboard-success-message-value="<%= t('clipboard.copied_to_clipboard') %>"
         data-clipboard-error-message-value="<%= t('clipboard.copy_failed') %>">
      <%= link_to t('buttons.copy'), '#', class: 'input-group-text', data: { action: 'click->clipboard#copy' } %>
      <%= text_field_tag nil, webcal_user_url(webcal_token: @uzanto.webcal_token, format: :ics), readonly: true, class: 'form-control bg-color-white', data: { clipboard_target: 'source' } %>
    </div>
    <br>
    <p>
      <%= t("users.profile.webcal_info_3_html", link: link_to(t("users.profile.this_link"), webcal_user_url(webcal_token: @uzanto.webcal_token, protocol: :webcal, format: :ics))) %>
    </p>

    <% dialog.with_footer do %>
      <%= render Ui::ButtonComponent.new(t("buttons.close"), variant: :secondary, data: {action: "dialog#close"}) %>
    <% end %>
  <% end %>
<% end %>

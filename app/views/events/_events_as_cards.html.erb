<h5 class="text-center fw-bold">
  <%= t("events.upcoming_events_count", count: @kvanto_venontaj_eventoj) if events.count > 0 %>
</h5>

<% if events.count > 0 && @nearby_events_count.to_i > 0 %>
  <p class="text-center text-muted small mb-1">
    <%= t("events.nearby_breakdown", city_count: @target_city_events_count, city: @target_city_name, nearby_count: @nearby_events_count, radius: @nearby_radius_km) %>
    (<%= link_to t("events.hide"), nearby_toggle_link_path(include_nearby: true), class: "small" %>)
  </p>
<% end %>

<% if past_events_listing_path && @card_view && @has_nearby_events && !@include_nearby %>
  <div class="text-center mb-3">
    <%= link_to t("events.show_nearby"), nearby_toggle_link_path(include_nearby: false), class: "small" %>
  </div>
<% end %>

<% events.grouped_by_months.each do |date, events| %>
  <br>
  <h3 class="text-divider"><%= l(date, format: "%B %Y") %></h3>
  <div class="row">
    <% events.each do |event| %>
      <div class="col-12 col-sm-6 col-lg-4 mb-4">
        <%= render Events::CardComponent.new(event: event) %>
      </div>
    <% end %>
  </div>
<% end %>

<% if past_events_listing_path && events.any? %>
  <div class="text-center mb-3">
    <%= link_to t("events.show_past"), past_events_listing_path, class: "small" %>
  </div>
<% end %>

<%= render "shared/pagination", pagy: @pagy %>

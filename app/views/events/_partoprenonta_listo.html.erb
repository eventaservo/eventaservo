<%= link_to t("events.participants.and_more"), '#', data: { dialog_open: 'partoprenontojModal' } %>

<% modal_title = event.past? ? t("events.participants.count_interested_past", count: event.participants.count) : t("events.participants.count_interested_future", count: event.participants.count) %>
<%= render Ui::ModalComponent.new(id: "partoprenontojModal", title: modal_title, title_id: "titolo", scrollable: true) do %>
  <div class="text-start" style="font-weight: normal; font-size: 1rem;">
    <% @partoprenontoj.publicly_listed.each do |participant| %>
      <% next unless participant.user %>

      <br>
      <%= link_to display_user(participant.user), events_by_username_path(username: participant.user&.username) %>
      <br>
    <% end %>

    <% if @partoprenontoj.not_publicly_listed.count > 0 %>
      <p>
        <br>
        <%= t("events.participants.anonymous_count", count: @partoprenontoj.not_publicly_listed.count) %>
      </p>
    <% end %>
  </div>
<% end %>

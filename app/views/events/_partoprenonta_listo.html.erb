<%= link_to t("events.participants.and_more"), '#', data: { bs_target: '#partoprenontojModal', bs_toggle: 'modal' } %>

<div id="partoprenontojModal" class="modal fade" aria-hidden="true" aria-labelledby="titolo" role="dialog" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content text-start">

      <div class="modal-header">
        <h5 class="modal-title" id="titolo">
          <%= event.past? ? t("events.participants.count_interested_past", count: event.participants.count) : t("events.participants.count_interested_future", count: event.participants.count) %>
        </h5>

        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('buttons.close') %>"></button>
      </div>

      <div class="modal-body" style="font-weight: normal; font-size: 1rem;">
        <% @partoprenontoj.publicly_listed.each do |participant| %>
          <% next unless participant.user %>

          <br>
          <%= link_to display_user(participant.user), events_by_username_path(username: participant.user&.username) %>
          <br>
        <% end %>

        <% if @partoprenontoj.not_publicly_listed.count > 0 %>
          <p>
            <br>
            <%= t("events.participants.anonymous_count", count: @partoprenontoj.not_publicly_listed.count) %>
          </p>
        <% end %>
      </div>

    </div>
  </div>
</div>

<%= link_to icon("fas", "exclamation-triangle", t("pages.event.report_problem")), "#",
  class: "tw:inline-flex tw:items-center tw:gap-1 tw:px-2 tw:py-1 tw:text-sm tw:text-amber-600 tw:hover:bg-amber-50 tw:rounded tw:no-underline tw:transition-colors",
  data: {dialog_open: "reportProblemModal"} %>

<%= render Ui::ModalComponent.new(
  id: "reportProblemModal",
  title: t("pages.event.report_problem_form.title"),
  title_id: "reportProblemModalCenterTitle",
  padded: false,
  dialog_data: {controller: "report-problem-form"}
) do |dialog| %>
  <%= form_tag event_kontakti_organizanton_url(event_code: @event.code), class: "tw:text-start" do %>
    <div class="<%= dialog.body_classes %> tw:text-base tw:font-normal">
      <p class="tw:mb-3"><%= t("pages.event.report_problem_form.text") %></p>
      <div class="tw:mb-3">
        <%= render Ui::TextareaComponent.new(:message, label: t("pages.event.report_problem_form.message"), rows: 4, required: true, data: {report_problem_form_target: "message"}) %>
      </div>
    </div>

    <div class="<%= dialog.footer_classes %>">
      <%= render Ui::ButtonComponent.new(t("buttons.cancel"), variant: :cancel, data: {action: "dialog#close"}) %>
      <%= render Ui::ButtonComponent.new(t("buttons.send"), variant: :primary, type: :submit) %>
    </div>
  <% end %>
<% end %>

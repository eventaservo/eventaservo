<%= link_to icon('fas', 'exclamation-triangle', t("pages.event.report_problem")), '#', class: 'btn btn-sm btn-outline-warning no-border', data: { dialog_open: 'reportProblemModal' } %>

<%= render Ui::ModalComponent.new(
  id: "reportProblemModal",
  title: t("pages.event.report_problem_form.title"),
  title_id: "reportProblemModalCenterTitle",
  padded: false,
  dialog_data: { controller: "report-problem-form" }
) do |dialog| %>
  <%= form_tag event_kontakti_organizanton_url(event_code: @event.code), class: "text-start" do %>
    <div class="<%= dialog.body_classes %>" style="font-weight: normal; font-size: 1rem;">
      <p><%= t("pages.event.report_problem_form.text") %></p>
      <div class="mb-3">
        <label><%= t("pages.event.report_problem_form.message") %></label>
        <%= text_area_tag :message, nil, class: 'form-control', rows: 4, required: true, data: { report_problem_form_target: "message" } %>
      </div>
    </div>

    <div class="<%= dialog.footer_classes %>">
      <%= render Ui::ButtonComponent.new(t("buttons.cancel"), variant: :cancel, data: {action: "dialog#close"}) %>
      <%= render Ui::ButtonComponent.new(t("buttons.send"), variant: :primary, type: :submit) %>
    </div>
  <% end %>
<% end %>

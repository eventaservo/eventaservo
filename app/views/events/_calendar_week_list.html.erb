<div class="tw:border tw:border-gray-200 tw:rounded tw:overflow-hidden tw:text-sm">
  <% (date..(date + 6.days)).each_with_index do |day, di| %>
    <% day_events = events_by_day[day] || [] %>
    <div class="<%= "tw:border-t tw:border-gray-200" if di > 0 %>">
      <div class="tw:grid tw:grid-cols-12 tw:items-center tw:bg-esperanto-500 tw:text-white tw:uppercase tw:font-bold tw:px-2 tw:py-1">
        <div class="tw:col-span-3 tw:md:col-span-1"><%= l(day, format: :short) %></div>
        <div class="tw:col-span-9 tw:md:col-span-11 tw:uppercase"><%= l(day, format: "%A") %></div>
      </div>

      <% if day_events.empty? %>
        <div class="tw:px-2 tw:py-1 tw:text-gray-500 tw:italic tw:text-xs"><%= t("events.calendar.no_events") %></div>
      <% else %>
        <% day_events.each_with_index do |event, i| %>
          <div class="tw:grid tw:grid-cols-12 tw:items-center tw:px-2 tw:py-1 hover-row tw:relative <%= "tw:border-b tw:border-gray-200" unless i == day_events.size - 1 %>">
            <%= render "events/calendar_event_row", event: event %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<% content_for :title do %>
  <%= continent_display_name(params[:continent]) %>
<% end %>

<div class="box-white">
  <%# Montras WebCAl ikonon nur por Retaj 'kontinentoj' %>
  <% if params[:continent] == 'reta' %>
    <% content_for :breadcrumb_right do %>
      <%= link_to icon('far', 'calendar-alt'), webcal_url(landa_kodo: 'ol', protocol: :webcal, format: :ics), data: { dialog_open: 'webcalModal' }, aria: { label: t('events.webcal_modal.subscribe_calendar') } %>
      <%= link_to icon('fas', 'rss'), events_by_continent_path(continent: params[:continent], format: :xml), title: 'RSS', class: 'me-2', aria: { label: 'RSS' } %>
    <% end %>
  <% end %>

  <%= render partial: 'layouts/breadcrumb' %>

  <% if @past_mode %>
    <% unless params[:continent] == 'reta' %>
      <div class="text-center m-2">
        <% @countries.each do |country| %>
          <%= link_to events_by_country_path(continent: country.continent.normalized, country_name: country.name, pasintaj: 1), class: 'button-event-count' do %>
            <%= flag_icon(country.code, squared: true) %>
            <%= country.name %>
            <span class="badge text-bg-secondary"><%= country.count %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <%= render partial: "events/events_as_cards_pasintaj", locals: {events: @events} %>
  <% else %>
    <%= render partial: 'home/view_style_chooser', locals: { kartaro: true, kalendaro: false, mapo: true } %>

    <% unless params[:continent] == 'reta' %>
      <div class="text-center m-2">
        <% @countries.each do |country| %>
          <%= link_to events_by_country_path(continent: country.continent.normalized, country_name: country.name, periodo: params[:periodo].presence, o: params[:o].presence, s: params[:s].presence), class: 'button-event-count' do %>
            <%= flag_icon(country.code, squared: true) %>
            <%= country.name %>
            <span class="badge text-bg-primary"><%= country.count %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%= render partial: 'home/filters' %>
    <%= render partial: 'events/okazantaj' %>
    <%= display_events_by_style %>
    <% unless cards_view_mode? %>
      <%= render partial: "events/past_events_toggle", locals: {past_url: past_events_listing_path} %>
    <% end %>
  <% end %>
</div>

<%= render Ui::ModalComponent.new(id: "webcalModal", title: t("events.webcal_modal.title"), title_id: "shareModalCenterTitle", size: :lg) do |dialog| %>
  <p>
    <%= t("events.webcal_modal.calendar_subscription_info") %>
  </p>
  <p>
    <%= t("events.webcal_modal.online_intro_html", help_link: link_to(t("events.webcal_modal.help_article_link"), 'https://github.com/eventaservo/eventaservo/wiki/Webcal-(Google-Calendar---iCal)', target: :'_blank', rel: 'noopener noreferrer')) %>
  </p>
  <div class="input-group" data-controller="clipboard"
       data-clipboard-success-message-value="<%= t('clipboard.copied_to_clipboard') %>"
       data-clipboard-error-message-value="<%= t('clipboard.copy_failed') %>">
    <div class="input-group-text">
      <%= link_to t("buttons.copy"), '#', data: { action: 'click->clipboard#copy' } %>
    </div>
    <%= text_field_tag nil, webcal_url(landa_kodo: 'ol', format: :ics), readonly: true, class: 'form-control bg-color-white', data: { clipboard_target: 'source' } %>
  </div>
  <br>
  <p>
    <%= t("events.webcal_modal.auto_subscribe_html", link: link_to(t("events.webcal_modal.auto_subscribe_link"), webcal_url(landa_kodo: 'ol', protocol: :webcal, format: :ics))) %>
  </p>

  <% dialog.with_footer do %>
    <%= render Ui::ButtonComponent.new(t("buttons.close"), variant: :secondary, data: {action: "dialog#close"}) %>
  <% end %>
<% end %>

<% content_for :title do %>
  <%= @country.name %>
<% end %>

<div class="box-white">
  <% content_for :breadcrumb_right do %>
    <%= link_to icon('far', 'calendar-alt'), webcal_url(landa_kodo: @country.code, protocol: :webcal, format: :ics), data: { bs_target: '#webcalModal', bs_toggle: 'modal' }, aria: { label: t('events.webcal_modal.subscribe_calendar') } %>
    <%= link_to icon('fas', 'rss'), events_by_country_path(continent: @country.continent.normalized, country_name: @country.name.normalized, format: :xml), title: 'RSS', class: 'me-2', aria: { label: 'RSS' } %>
  <% end %>
  <%= render partial: 'layouts/breadcrumb' %>

  <% if @past_mode %>
    <div class="text-center m-2">
      <% @cities.each do |city| %>
        <%= link_to events_by_city_path(continent: @country.continent.normalized, country_name: @country.name, city_name: city.name, pasintaj: 1), class: 'button-event-count' do %>
          <%= city.name %>
          <span class="badge text-bg-secondary"><%= city.count %></span>
        <% end %>
      <% end %>
    </div>
    <%= render partial: "events/events_as_cards_pasintaj", locals: {events: @events} %>
  <% else %>
    <%= render partial: 'home/view_style_chooser', locals: { kartaro: true, kalendaro: false, mapo: true } %>

    <div class="text-center m-2">
      <% @cities.each do |city| %>
        <%= link_to events_by_city_path(continent: @country.continent.normalized, country_name: @country.name, city_name: city.name, periodo: params[:periodo].presence, o: params[:o].presence, s: params[:s].presence), class: 'button-event-count' do %>
          <%= city.name %>
          <span class="badge text-bg-primary"><%= city.count %></span>
        <% end %>
      <% end %>
    </div>

    <%= render partial: 'home/filters' %>
    <%= render partial: 'events/okazantaj' %>
    <% unless cards_view_mode? %>
      <%= render partial: "events/past_events_toggle", locals: {past_url: past_events_listing_path} %>
    <% end %>
    <%= display_events_by_style %>
  <% end %>
</div>

<div id="webcalModal" class="modal fade" aria-hidden="true" role="dialog" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 id="shareModalCenterTitle" class="modal-title"><%= t("events.webcal_modal.title") %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("buttons.close") %>"></button>
      </div>
      <div class="modal-body">
        <p>
          <%= t("events.webcal_modal.calendar_subscription_info") %>
        </p>
        <p>
          <%= t("events.webcal_modal.country_intro_html", country: "#{flag_icon(@country.code)} #{@country.name}".html_safe, help_link: link_to(t("events.webcal_modal.help_article_link"), 'https://github.com/eventaservo/eventaservo/wiki/Webcal-(Google-Calendar---iCal)', target: :'_blank', rel: 'noopener noreferrer')) %>
        </p>
        <div class="input-group" data-controller="clipboard"
             data-clipboard-success-message-value="<%= t('clipboard.copied_to_clipboard') %>"
             data-clipboard-error-message-value="<%= t('clipboard.copy_failed') %>">
          <div class="input-group-text">
              <%= link_to t("buttons.copy"), '#', data: { action: 'click->clipboard#copy' } %>
          </div>
          <%= text_field_tag nil, webcal_url(landa_kodo: @country.code, format: :ics), readonly: true, class: 'form-control bg-color-white', data: { clipboard_target: 'source' } %>
        </div>
        <br>
        <p>
          <%= t("events.webcal_modal.auto_subscribe_html", link: link_to(t("events.webcal_modal.auto_subscribe_link"), webcal_url(landa_kodo: @country.code, protocol: :webcal, format: :ics))) %>
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal"><%= t("buttons.close") %></button>
      </div>
    </div>
  </div>
</div>

<% if Calendar.utc_offset(@event.time_zone) == Calendar.utc_offset(@horzono) && !@event.all_day? %>
  <span class="badge float-end text-bg-light fw-normal">
    Sama kiel via horzono
  </span>
<% else %>
  <% unless @event.komenca_horo == '00:00' && @event.fina_horo == '00:00' %>
    <% if @event.start_date_label(horzono: @event.time_zone) != @event.start_date_label(horzono: @horzono) %>
      <hr>
      <%= render partial: 'kalendareto', locals: { event: @event, tz: @horzono } %>
    <% end %>
    <%= render partial: 'horoj', locals: { tz: @horzono } %>
  <% end %>
<% end %>

<%# Navigation links target "native-calendar" explicitly so Turbo Frame navigation
    works correctly even if this partial is ever rendered outside the frame context. %>
<div class="tw:flex tw:flex-col tw:md:flex-row tw:items-stretch tw:md:items-center tw:gap-2 tw:mb-2 tw:w-full">
  <% week_end = date + 6.days %>
  <% month_names = I18n.t("date.month_names") %>
  <strong class="tw:uppercase tw:text-xl tw:font-bold tw:text-start tw:shrink-0">
    <% if date.year != week_end.year %>
      <%= date.day %> <%= month_names[date.month].upcase %> <%= date.year %> – <%= week_end.day %> <%= month_names[week_end.month].upcase %> <%= week_end.year %>
    <% elsif date.month != week_end.month %>
      <%= date.day %> <%= month_names[date.month].upcase %> – <%= week_end.day %> <%= month_names[week_end.month].upcase %> <%= date.year %>
    <% else %>
      <%= date.day %> – <%= week_end.day %> <%= month_names[date.month].upcase %> <%= date.year %>
    <% end %>
  </strong>
  <div class="tw:flex tw:items-center tw:justify-between tw:md:justify-end tw:gap-2 tw:flex-wrap tw:md:flex-nowrap tw:w-full tw:md:grow">
    <%= render Ui::DropdownComponent.new(menu_id: "calendarMonthNavigationMenu", align: :right, width: :auto) do |dropdown| %>
      <% dropdown.with_trigger(t("events.calendar.jump_to_month"), id: "calendarMonthNavigation", variant: :light) %>
      <% month_navigation_options.each do |label, path| %>
        <% dropdown.with_item(label, href: path, data: {turbo_frame: "native-calendar", action: "click->menu#close"}) %>
      <% end %>
    <% end %>

    <%= link_to t("events.calendar.today"), today_path,
      class: "tw:inline-flex tw:items-center tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium tw:bg-gray-100 tw:border tw:border-gray-200 tw:rounded-md tw:text-gray-800 tw:hover:bg-gray-200 tw:no-underline",
      data: {turbo_frame: "native-calendar"} %>

    <div class="tw:inline-flex tw:rounded-md tw:border tw:border-gray-200 tw:overflow-hidden tw:divide-x tw:divide-gray-200" role="group" aria-label="<%= t("events.calendar.week_navigation") %>">
      <%= link_to icon("fas", "chevron-left"), prev_path,
          class: "tw:inline-flex tw:items-center tw:px-3 tw:py-1.5 tw:text-sm tw:bg-gray-100 tw:text-gray-800 tw:hover:bg-gray-200 tw:no-underline",
          title: t("events.calendar.previous_week"),
          aria: {label: t("events.calendar.previous_week")},
          data: {turbo_frame: "native-calendar"} %>
      <%= link_to icon("fas", "chevron-right"), next_path,
          class: "tw:inline-flex tw:items-center tw:px-3 tw:py-1.5 tw:text-sm tw:bg-gray-100 tw:text-gray-800 tw:hover:bg-gray-200 tw:no-underline",
          title: t("events.calendar.next_week"),
          aria: {label: t("events.calendar.next_week")},
          data: {turbo_frame: "native-calendar"} %>
    </div>
  </div>
</div>

<%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
  <% panel.with_body(class: "tw:space-y-4") do %>
    <div class="tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-2 tw:pb-2 tw:border-b tw:border-gray-200">
      <h1 class="tw:text-xl tw:font-bold tw:text-gray-900 tw:m-0"><%= event_flag(@event) %> <%= @event.title %></h1>
      <%= render Ui::ButtonComponent.new(t("events.chronology.view_event"), href: event_url(code: @event.ligilo), variant: :outline_primary, size: :small) %>
    </div>

    <h4 class="tw:text-base tw:font-semibold tw:text-gray-800 tw:text-center tw:m-0"><%= t("events.chronology.title") %></h4>

    <% if @versions.any? %>
      <div class="tw:space-y-3">
        <% @versions.each do |version| %>
          <% next if version.changeset.empty? %>

          <%= render Ui::CardComponent.new(variant: :bordered, size: :small) do |version_panel| %>
            <% version_panel.with_body(class: "tw:space-y-2 tw:text-xs") do %>
              <p class="tw:m-0 tw:font-medium tw:text-gray-700">
                <%= version.user_name if version.user_name %>
                en <%= format_date version.created_at %> <%= version.event %>:
              </p>

              <div class="tw:divide-y tw:divide-gray-100">
                <% version.changeset.except(:updated_at).each do |item, changes| %>
                  <div class="tw:grid tw:grid-cols-1 tw:sm:grid-cols-12 tw:gap-2 tw:py-1.5">
                    <div class="tw:sm:col-span-3 tw:font-semibold tw:text-gray-600"><%= t item %>:</div>
                    <div class="tw:sm:col-span-9 tw:overflow-x-auto">
                      <% old = changes[0] %>
                      <% new = changes[1] %>
                      <% if item == "user_id" %>
                        <% old = @users_cache&.dig(old.to_i)&.name if old %>
                        <% new = @users_cache&.dig(new.to_i)&.name if new %>
                      <% end %>
                      <% if item == "country_id" %>
                        <% old = @countries_cache&.dig(old.to_i)&.name if old %>
                        <% new = @countries_cache&.dig(new.to_i)&.name if new %>
                      <% end %>

                      <%= sanitize(
                            Diffy::Diff.new(
                              ERB::Util.html_escape(old.to_s),
                              ERB::Util.html_escape(new.to_s)
                            ).to_s(:html),
                            tags: %w[div ul li del ins strong],
                            attributes: %w[class]
                          ) %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <%= render "shared/pagination", pagy: @pagy %>
    <% else %>
      <div class="tw:text-center tw:text-gray-500 tw:py-6 tw:text-sm">
        <p class="tw:m-0"><%= t("events.chronology.no_changes") %></p>
      </div>
    <% end %>
  <% end %>
<% end %>

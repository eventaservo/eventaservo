<%= render Ui::CardComponent.new(
  variant: :interactive,
  flush: true,
  href: events_by_username_path(username: instruisto.username),
  class: "tw:h-full tw:no-underline tw:text-inherit"
) do |panel| %>
  <% panel.with_body(padding: false) do %>
    <div class="tw:bg-blue-50 tw:border-b tw:border-blue-100 tw:px-3 tw:py-3">
      <div class="tw:flex tw:items-center tw:gap-3">
        <%= display_user_image(instruisto) %>
        <div class="tw:min-w-0 tw:flex-1">
          <h3 class="tw:text-sm tw:font-bold tw:text-gray-900 tw:m-0 tw:truncate">
            <%= instruisto.name %>
          </h3>
          <span class="tw:text-gray-600 tw:text-xs">
            <%= display_flag(instruisto.country) %>
            <%= instruisto.country.name %>
          </span>
        </div>
      </div>
    </div>

    <div class="tw:p-3 tw:space-y-3">
      <div>
        <div class="tw:text-[11px] tw:uppercase tw:tracking-wider tw:font-semibold tw:text-gray-400 tw:mb-1.5">
          <i class="fas fa-layer-group tw:mr-1" aria-hidden="true"></i><%= t("teachers_and_speakers.cards.levels") %>
        </div>
        <div class="tw:flex tw:flex-wrap tw:gap-1">
          <% instruisto.instruo["nivelo"].each do |nivelo| %>
            <%= render Ui::BadgeComponent.new(
              t("teachers_and_speakers.levels.#{nivelo.downcase}", default: nivelo.capitalize),
              variant: :primary,
              shape: :pill,
              size: :small
            ) %>
          <% end %>
        </div>
      </div>

      <div>
        <div class="tw:text-[11px] tw:uppercase tw:tracking-wider tw:font-semibold tw:text-gray-400 tw:mb-1">
          <i class="fas fa-briefcase tw:mr-1" aria-hidden="true"></i><%= t("teachers_and_speakers.cards.experience") %>
        </div>
        <p class="tw:text-xs tw:text-gray-600 tw:m-0 tw:break-words"><%= instruisto.instruo["sperto"] %></p>
      </div>
    </div>
  <% end %>
<% end %>

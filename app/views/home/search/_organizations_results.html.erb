<%= render Ui::CardComponent.new(variant: :bordered, flush: true) do |panel| %>
  <% panel.with_header(class: "tw:bg-esperanto-600 tw:text-white tw:py-2 tw:px-4 tw:border-0") do %>
    <span class="tw:text-xs tw:font-bold tw:uppercase tw:tracking-wider"><%= t("search.results.organizations.header") %></span>
  <% end %>
  <% panel.with_body(padding: true, class: "tw:space-y-3") do %>
    <% if organizations.empty? %>
      <p class="tw:text-sm tw:text-gray-600 tw:m-0"><%= t("search.results.organizations.empty") %></p>
    <% else %>
      <h2 class="tw:text-base tw:font-semibold tw:text-gray-900 tw:m-0"><%= t("search.results.organizations.found", count: organizations.count) %></h2>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:overflow-hidden tw:divide-y tw:divide-gray-200 tw:text-xs">
        <% organizations.each do |organizo| %>
          <%= link_to organization_path(short_name: organizo.short_name),
                class: "tw:block tw:px-3 tw:py-2 tw:text-gray-900 tw:no-underline tw:hover:bg-gray-50 tw:transition-colors" do %>
            <%= display_flag(organizo.country) if organizo.display_flag %> <%= organizo.name %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>

<div class="box-white">
  <div class="box-header"><%= t("search.results.events.header") %></div>
  <% if events.empty? %>
    <p><%= t("search.results.events.empty") %></p>
  <% else %>
    <h5>
      <%= t("search.results.events.found", count: events.count) %>
      <% if params[:pasintaj].blank? %>
        <%= t("search.results.events.upcoming_and_recent") %>
      <% end %>
    </h5>

    <div class="table-responsive">
      <table class="table table-sm table-hover">
        <thead>
          <tr>
            <th><%= t("search.results.events.title") %></th>
            <th><%= t("search.results.events.city") %></th>
            <th><%= t("search.results.events.date") %></th>
          </tr>
        </thead>
        <tbody>
          <% events.each do |event| %>
            <tr class="small pointer <%= event_color_class(event) %>"
                data-href="<%= event_path(code: event.ligilo) %>"
                onclick="window.location.href = this.dataset.href">
              <td><%= event_flag(event) %> <%= event.title %></td>
              <td><%= event.city %></td>
              <td><%= event_date(event) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

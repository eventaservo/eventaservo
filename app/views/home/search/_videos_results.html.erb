<%= render Ui::CardComponent.new(variant: :bordered, flush: true) do |panel| %>
  <% panel.with_header(class: "tw:bg-esperanto-600 tw:text-white tw:py-2 tw:px-4 tw:border-0") do %>
    <span class="tw:text-xs tw:font-bold tw:uppercase tw:tracking-wider"><%= t("search.results.videos.header") %></span>
  <% end %>
  <% panel.with_body(padding: true, class: "tw:space-y-3") do %>
    <% if videos.empty? %>
      <p class="tw:text-sm tw:text-gray-600 tw:m-0"><%= t("search.results.videos.empty") %></p>
    <% else %>
      <h2 class="tw:text-base tw:font-semibold tw:text-gray-900 tw:m-0"><%= t("search.results.videos.found", count: videos.count) %></h2>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:overflow-hidden tw:text-xs">
        <div class="tw:grid tw:grid-cols-12 tw:gap-2 tw:bg-gray-100 tw:text-gray-700 tw:font-semibold tw:px-3 tw:py-2 tw:border-b tw:border-gray-200">
          <div class="tw:col-span-5"><%= t("search.results.videos.title") %></div>
          <div class="tw:col-span-4"><%= t("search.results.videos.event") %></div>
          <div class="tw:col-span-3"><%= t("search.results.videos.date") %></div>
        </div>
        <div class="tw:divide-y tw:divide-gray-200">
          <% videos.each do |video| %>
            <%= link_to video.url,
                  target: "_blank",
                  rel: "noopener",
                  class: "tw:grid tw:grid-cols-12 tw:gap-2 tw:items-center tw:px-3 tw:py-2 tw:text-gray-900 tw:no-underline tw:hover:bg-gray-50 tw:transition-colors" do %>
              <div class="tw:col-span-5 tw:font-medium tw:break-words"><%= video.title %></div>
              <div class="tw:col-span-4 tw:text-gray-600 tw:break-words"><%= video.evento.title %></div>
              <div class="tw:col-span-3 tw:text-gray-600 tw:break-words"><%= format_date(video.evento.komenca_dato, style: :month_year).downcase %></div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

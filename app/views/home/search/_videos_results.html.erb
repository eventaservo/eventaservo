<div class="box-white">
  <div class="box-header"><%= t("search.results.videos.header") %></div>
  <% if videos.empty? %>
    <p><%= t("search.results.videos.empty") %></p>
  <% else %>
    <h5><%= t("search.results.videos.found", count: videos.count) %></h5>
    <div class="table-responsive">
      <table class="table table-sm table-hover">
        <thead>
          <tr>
            <th><%= t("search.results.videos.title") %></th>
            <th><%= t("search.results.videos.event") %></th>
            <th><%= t("search.results.videos.date") %></th>
          </tr>
        </thead>
        <tbody>
          <% videos.each do |video| %>
            <tr class="small pointer" onclick="window.location.href='<%= video.url %>'">
              <td><%= video.title %></td>
              <td><%= video.evento.title %></td>
              <td><%= format_date(video.evento.komenca_dato, style: :month_year).downcase %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

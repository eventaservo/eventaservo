<% content_for :head do %>
  <%= render "layouts/mapbox_token" %>
<% end %>

<%= render Ui::CardComponent.new(variant: :bordered, class: "tw:my-1 tw:sm:my-2") do |panel| %>
  <% panel.with_body(padding: false, class: "tw:p-2 tw:sm:p-4") do %>
    <div class="tw:flex tw:items-start tw:md:items-center tw:justify-around tw:gap-2 tw:text-center tw:text-esperanto-500 tw:font-bold tw:mb-2">
      <div class="tw:shrink-0">
        <%= link_to image_tag("uea_emblemeto.png", alt: "UEA logo", class: "tw:h-9 tw:w-auto"), prie_url %>
      </div>
      <div class="tw:min-w-0">
        <%= t("tagline") %>
      </div>
      <div class="tw:shrink-0">
        <%= link_to image_tag("tejo.svg", alt: "TEJO logo", class: "tw:h-7 tw:w-auto"), prie_url %>
      </div>
    </div>

    <div class="tw:flex tw:flex-col tw:items-center tw:gap-1 tw:text-center tw:text-xs">
      <div class="tw:flex tw:flex-wrap tw:items-center tw:justify-center tw:gap-x-1 tw:gap-y-0.5">
        <%= render Ui::ButtonComponent.new(t("links.announcements_and_contests"), href: anoncoj_url, icon: "bullhorn", variant: :link, size: :small) %>
        <span aria-hidden="true" class="tw:text-gray-400">|</span>
        <%= render Ui::ButtonComponent.new(t("links.reports"), href: reports_url, icon: "calendar-check", variant: :link, size: :small) %>
        <span aria-hidden="true" class="tw:text-gray-400">|</span>
        <%= render Ui::ButtonComponent.new(t("links.teachers_and_lecturers"), href: instruantoj_kaj_prelegantoj_path, icon: "person-chalkboard", variant: :link, size: :small) %>
        <span aria-hidden="true" class="tw:text-gray-400">|</span>
        <%= render Ui::ButtonComponent.new(t("links.presentations"), href: video_url, icon: "video", variant: :link, size: :small) %>
      </div>
      <div>
        <%= render Ui::ButtonComponent.new(t("links.international_calendar"), href: international_calendar_path, icon: "calendar", icon_style: "far", variant: :new_link, size: :small, class: "tw:font-bold") %>
      </div>
    </div>

    <div id="events_container" class="tw:mt-4">
      <%= render partial: "home/view_style_chooser", locals: {kartaro: false, kalendaro: true, mapo: true} %>

      <div class="tw:flex tw:flex-wrap tw:justify-center tw:gap-1.5 tw:mt-2 tw:mb-5">
        <% @continents.each do |continent| %>
          <%= render Ui::ButtonComponent.new(
                href: events_by_continent_path(
                  continent: continent.name.normalized,
                  periodo: params[:periodo].presence,
                  o: params[:o].presence,
                  s: params[:s].presence,
                  f: params[:f].presence
                ),
                variant: :outline_primary,
                size: :small
              ) do %>
            <span><%= continent_display_name(continent.name) %></span>
            <%= render Ui::BadgeComponent.new(
                  (continent.name == "reta" ? Event.online.venontaj(current_timezone).count : continent.count).to_s,
                  variant: :primary,
                  shape: :pill,
                  size: :small
                ) %>
          <% end %>
        <% end %>
      </div>

      <%= render partial: "home/filters" %>

      <div class="tw:flex tw:justify-center tw:mt-2 tw:mb-4">
        <%= render "home/current_timezone" %>
      </div>
      <%= @ads_html %>
      <%= render partial: "events/okazantaj" if cookies[:vidmaniero].in?(%w[kartoj kartaro]) %>
      <%= display_events_by_style %>
    </div>

    <div id="search_results"></div>
  <% end %>
<% end %>

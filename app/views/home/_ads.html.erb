<% if ads.any? %>
  <div class="tw:flex tw:justify-around tw:gap-2 tw:mt-1 tw:mb-3">
    <% responsive_classes = [nil, "tw:hidden tw:sm:block", "tw:hidden tw:md:block", "tw:hidden tw:lg:block"] %>
    <% ads.each_with_index do |ad, index| %>
      <%= link_to ad.url, class: responsive_classes[index] do %>
        <%= image_tag rails_blob_representation_proxy_path(
              ad.image.blob.signed_id,
              ad.image.variant(resize_to_fill: [400, 200]).processed.variation.key,
              ad.image.blob.filename.to_s
            ), width: 200, height: 100, alt: t("home.ads.alt"), loading: "lazy", class: "reklam-bildo" %>
      <% end %>
    <% end %>
  </div>
<% end %>

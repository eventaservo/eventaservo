<%= render Ui::CardComponent.new(
  variant: :interactive,
  flush: true,
  href: events_by_username_path(username: preleganto.username),
  class: "tw:h-full tw:no-underline tw:text-inherit"
) do |panel| %>
  <% panel.with_body(padding: false) do %>
    <div class="tw:bg-esperanto-50 tw:border-b tw:border-esperanto-100 tw:px-3 tw:py-3">
      <div class="tw:flex tw:items-center tw:gap-3">
        <%= display_user_image(preleganto) %>
        <div class="tw:min-w-0 tw:flex-1">
          <h3 class="tw:text-sm tw:font-bold tw:text-gray-900 tw:m-0 tw:truncate">
            <%= preleganto.name %>
          </h3>
          <span class="tw:text-gray-600 tw:text-xs">
            <%= display_flag(preleganto.country) %>
            <%= preleganto.country.name %>
          </span>
        </div>
      </div>
    </div>

    <div class="tw:p-3">
      <div class="tw:text-[11px] tw:uppercase tw:tracking-wider tw:font-semibold tw:text-esperanto-600 tw:mb-1.5">
        <i class="fas fa-comments tw:mr-1" aria-hidden="true"></i><%= t("teachers_and_speakers.cards.topics") %>
      </div>
      <%= simple_format(preleganto.prelego["temoj"], class: "tw:text-xs tw:text-gray-600 tw:m-0 tw:break-words") %>
    </div>
  <% end %>
<% end %>

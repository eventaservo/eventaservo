<div class="box-white">
  <div class="text-center">
    <h1>
      <%= icon("fas", "person-chalkboard", t("teachers_and_speakers.title")) %>
    </h1>
  </div>

  <p>
    <%= t("teachers_and_speakers.intro") %>
  </p>

  <div class="row">
    <div class="col-12 col-md-6">
      <div class="text-center">
        <%= image_tag "edukadonet.jpg", alt: "Edukado.net", height: "150px" %>
      </div>
      <p>
        <%= t("teachers_and_speakers.edukado_html",
              edukado_link: link_to("Edukado.net", "https://edukado.net/prie", target: "_blank"),
              cefr_link: link_to(t("teachers_and_speakers.cefr"), "https://eo.wikipedia.org/wiki/Komuna_E%C5%ADropa_Referenckadro_por_Lingvoj", target: "_blank")) %>
      </p>
    </div>

    <div class="col-12 col-md-6">
      <div class="text-center">
        <%= image_tag "ilei.png", alt: "ILEI", height: "150px", class: "p-3" %>
      </div>
      <p>
        <%= t("teachers_and_speakers.ilei_html",
              ilei_link: link_to("ILEI", "https://eventaservo.org/o/ILEI", target: "_blank"),
              join_link: link_to(t("teachers_and_speakers.join_ilei"), "https://www.ilei.info/membrigxo.php", target: "_blank")) %>
      </p>
    </div>
  </div>

  <%= render "instruistoj_kaj_prelegantoj_filtro" %>

  <% unless @filtering %>
    <div class="text-center text-body-secondary small mb-3">
      <i class="fas fa-shuffle me-1"></i>
      <%= t("teachers_and_speakers.random_notice") %>
    </div>
  <% end %>

  <!-- Teachers -->
  <div class="text-divider"><%= t("teachers_and_speakers.teachers_divider") %></div>
  <% if @instruistoj.any? %>
    <div class="row g-3">
      <% @instruistoj.each do |instruisto| %>
        <div class="col-12 col-md-4">
          <%= render partial: "instruisto_karto", locals: {instruisto: instruisto} %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-body-secondary text-center py-3">
      <% if @filtering %>
        <i class="fas fa-search me-1"></i><%= t("teachers_and_speakers.no_teachers_filtered") %>
      <% else %>
        <i class="fas fa-user-slash me-1"></i><%= t("teachers_and_speakers.no_teachers_registered") %>
      <% end %>
    </p>
  <% end %>

  <!-- Speakers -->
  <div class="mt-4 text-divider"><%= t("teachers_and_speakers.speakers_divider") %></div>
  <% if @prelegantoj.any? %>
    <div class="row g-3">
      <% @prelegantoj.each do |preleganto| %>
        <div class="col-12 col-md-4">
          <%= render partial: "preleganto_karto", locals: {preleganto: preleganto} %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-body-secondary text-center py-3">
      <% if @filtering %>
        <i class="fas fa-search me-1"></i><%= t("teachers_and_speakers.no_speakers_filtered") %>
      <% else %>
        <i class="fas fa-user-slash me-1"></i><%= t("teachers_and_speakers.no_speakers_registered") %>
      <% end %>
    </p>
  <% end %>
</div>

<div class="tw:bg-white tw:p-5 tw:min-h-[400px] tw:flex tw:items-center tw:text-center">
  <div class="tw:w-full">
    <h3 class="tw:text-esperanto-500 tw:font-bold tw:text-xl tw:mb-3"><%= t("home.about.partners.title") %></h3>

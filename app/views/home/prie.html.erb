</div>

<div class="tw:bg-[#f7f7f7] tw:p-5 tw:min-h-[400px] tw:grid tw:grid-cols-1 tw:md:grid-cols-2 tw:gap-6 tw:items-center tw:text-center">
  <div>
    <h3 class="tw:text-esperanto-500 tw:font-bold tw:text-xl tw:mb-3"><%= t("home.about.features.device_title") %></h3>
    <p><%= t("home.about.features.device_p") %></p>
  </div>
  <div>
    <%= image_tag "prie/mobile.png", class: "tw:max-w-full tw:h-auto tw:max-h-[400px] tw:mx-auto tw:border tw:border-gray-300" %>
  </div>
</div>

<div class="tw:bg-white tw:p-5 tw:min-h-[400px] tw:flex tw:flex-col tw:justify-center tw:items-center tw:text-center tw:gap-6">
  <div class="tw:w-full">
    <h3 class="tw:text-esperanto-500 tw:font-bold tw:text-xl tw:mb-3"><%= t("home.about.uea_tejo.title") %></h3>
    <p class="tw:mb-3">
      <%= t("home.about.uea_tejo.p1_html",
            uea_link: link_to("Universala Esperanto-Asocio (UEA)", "https://uea.org", target: :_blank),
            tejo_link: link_to("Tutmonda Esperanta Junulara Organizo (TEJO)", "https://www.tejo.org", target: :_blank)) %>
    </p>
    <p>
      <%= t("home.about.uea_tejo.p2") %>
    </p>
  </div>
  <div class="tw:w-full tw:grid tw:grid-cols-2 tw:gap-6 tw:items-center">
    <div>
      <%= link_to image_tag("prie/uea.png", class: "tw:max-w-full tw:h-auto tw:max-h-[400px] tw:mx-auto"), "https://uea.org", target: :_blank %>
    </div>
    <div>
      <%= link_to image_tag("tejo.svg", class: "tw:w-3/4 tw:max-w-full tw:h-auto tw:max-h-[400px] tw:mx-auto"), "https://www.tejo.org", target: :_blank %>
    </div>
  </div>
</div>

<div class="tw:bg-[#f7f7f7] tw:p-5 tw:min-h-[400px] tw:flex tw:items-center tw:text-center">

      <div class="tw:text-esperanto-500 tw:font-bold tw:mb-2"><%= t("home.about.advantages.files_title") %></div>
      <p><%= t("home.about.advantages.files_p") %></p>
    </div>
    <div>
      <div class="tw:text-esperanto-500 tw:font-bold tw:mb-2"><%= t("home.about.advantages.social_title") %></div>
      <p><%= t("home.about.advantages.social_p") %></p>
    </div>
    <div>
      <div class="tw:text-esperanto-500 tw:font-bold tw:mb-2"><%= t("home.about.advantages.open_source_title") %></div>

<div class="text-center">
  <h1><%= t("home.about.title") %></h1>
  <p><%= t("home.about.tagline") %></p>
</div>

<div class="d-flex justify-content-around text-center m-2">
  <div>
    <h3><%= User.all.size %></h3>
    <p><%= t("home.about.registered_users") %></p>
  </div>
  <div>
    <h3><%= Event.all.size %></h3>
    <p><%= t("home.about.registered_events") %></p>
  </div>
</div>

<div class="full_rectangle bg-color-grayLighter" style="min-height: 0px;">
  <div class="col-12 col-md-5 px-3">
    <h3 class="title"><%= t("home.about.history.title") %></h3>
    <div style="text-align: justify;">
      <p>
        <%= t("home.about.history.p1_html",
              creator_link: link_to("Fernando Ŝajani", "https://t.me/fernandoshayani")) %>
      </p>
      <p>
        <%= t("home.about.history.p2") %>
      </p>
      <p>
        <%= t("home.about.history.p3_html",
              link: link_to(t("home.about.history.eventoj_hu_link_text"), "http://eventoj.hu/kalendaro.htm", target: :_blank)) %>
      </p>
    </div>
  </div>
  <div class="col-12 col-md-5 px-3">
    <h3 class="title"><%= t("home.about.helpers.title") %></h3>
    <div style="text-align: justify;">
      <p>
        <%= t("home.about.helpers.p1_html",
              yves_link: link_to("Yves Nevelsteen", "https://t.me/yvesnev"),
              robin_link: link_to("Robin van der Vliet", "https://t.me/robin")) %>
      </p>
      <p>
        <%= t("home.about.helpers.p2_html",
              fernando_link: link_to("Fernando Maia,", "https://t.me/fmaiajr")) %>
      </p>
      <p>
        <%= t("home.about.helpers.p3_html",
              telegram_link: link_to(t("home.about.helpers.telegram_link_text"), "https://eventaservo.telegramo.org", target: "_blank")) %>
      </p>
    </div>
  </div>
</div>

<div class="full_rectangle bg-color-white" style="min-height: 0px;">
  <div class="col-12">
    <h3 class="title"><%= t("home.about.articles.title") %></h3>
    <div style="text-align: justify;">
      <%= article_link("Eventa Servo: teknologiaj novigoj por pli moderna kaj alirebla platformo",
        "/ES-RevuoEsperanto-majo2026.pdf",
        t("home.about.articles.art1")) %>

      <%= article_link("MvP029 Eventa Servo",
        "https://movada-vid.punkto.info/2026/01/24/mvp029-eventa-servo/",
        t("home.about.articles.art2")) %>

      <%= article_link("Kiel kreskigi Esperantujon per Eventa Servo",
        "https://www.youtube.com/watch?v=ke-p-bnudTs%5D",
        t("home.about.articles.art3")) %>

      <%= article_link("Eventa Servo havigis novan retadreson",
        "https://www.liberafolio.org/2022/12/06/eventa-servo-havigis-novan-retadreson",
        t("home.about.articles.art4")) %>

      <%= article_link("Zamenhof-festoj tutmonde: superrigardo en Eventa Servo",
        "https://uea.org/aktuale/komunikoj/2022/Zamenhof-festoj-tutmonde-superrigardo-en-Eventa-Servo",
        t("home.about.articles.art5")) %>

      <%= article_link("Eventa Servo: evoluoj kaj planoj",
        "/ES-RevuoEsperanto-oktobro2022.pdf",
        t("home.about.articles.art6")) %>

      <%= article_link("Ĉu viaj eventoj estas diskonigindaj?",
        "/ES-RevuoEsperanto-februaro2020.pdf",
        t("home.about.articles.art7")) %>

      <%= article_link("Virtualaj eventoj anstataŭ la Malferma Tago kaj la UK en 2020",
        "https://uea.org/aktuale/komunikoj/2020/Virtualaj-eventoj-anstataux-la-Malferma-Tago-kaj-la-UK-en-2020",
        t("home.about.articles.art8")) %>

      <%= article_link("Eventa Servo helpas trovi retajn renkontiĝojn",
        "https://www.liberafolio.org/2020/04/23/eventa-servo-helpas-trovi-retajn-renkontigojn/",
        t("home.about.articles.art9")) %>

      <%= article_link("Prelego de Fernando Ŝajani pri Eventa Servo",
        "https://www.youtube.com/watch?v=t7YPEKvmHvo",
        t("home.about.articles.art10")) %>

      <%= article_link("Prelego de Yves Nevelsteen pri Eventa Servo",
        "https://www.youtube.com/watch?v=HQduoiEWUvo",
        t("home.about.articles.art11")) %>

      <%= article_link("Eventa Servo – La nova sistemo por diskonigi Esperantajn eventojn",
        "https://uea.org/l/?prenu=kto6_18",
        t("home.about.articles.art12")) %>

      <p>
        <%= t("home.about.articles.more_info_wiki_html",
              wiki_link: link_to(t("home.about.articles.in_wikipedia"), "https://eo.wikipedia.org/wiki/Eventa_Servo", target: :_blank)) %>
      </p>
    </div>
  </div>
</div>

<div class="full_rectangle bg-color-grayLighter align-items-center">
  <div class="col-12 col-md-6">
    <h3 class="title"><%= t("home.about.features.discover_title") %></h3>
    <p><%= t("home.about.features.discover_p1") %></p>
    <p><%= t("home.about.features.discover_p2") %></p>
  </div>
  <div class="col-12 col-md-6">
    <%= image_tag 'prie/mapo.png', class: 'screen-shot border' %>
  </div>
</div>

<div class="full_rectangle bg-color-white align-items-center">
  <div class="col-12 col-md-6 order-lg-2">
    <h3 class="title"><%= t("home.about.features.calendar_title") %></h3>
    <p><%= t("home.about.features.calendar_p") %></p>
  </div>
  <div class="col-12 col-md-6 order-lg-1">
    <%= image_tag 'prie/kalendaro.png', class: 'screen-shot' %>
  </div>
</div>

<div class="full_rectangle bg-color-grayLighter align-items-center">
  <div class="col-12 col-md-6">
    <h3 class="title"><%= t("home.about.features.device_title") %></h3>
    <p><%= t("home.about.features.device_p") %></p>
  </div>
  <div class="col-12 col-md-6">
    <%= image_tag 'prie/mobile.png', class: 'screen-shot border' %>
  </div>
</div>

<div class="full_rectangle bg-color-white align-items-center">
  <div class="row">
    <div class="col-12">
      <h3 class="title"><%= t("home.about.uea_tejo.title") %></h3>
      <p>
        <%= t("home.about.uea_tejo.p1_html",
              uea_link: link_to('Universala Esperanto-Asocio (UEA)', 'https://uea.org', target: :_blank),
              tejo_link: link_to('Tutmonda Esperanta Junulara Organizo (TEJO)', 'https://www.tejo.org', target: :_blank)) %>
      </p>
      <p>
        <%= t("home.about.uea_tejo.p2") %>
      </p>
    </div>
  </div>
  <div class="row">
    <div class="col-6">
      <%= link_to image_tag('prie/uea.png', class: 'screen-shot'), 'https://uea.org', target: :_blank %>
    </div>
    <div class="col-6">
      <%= link_to image_tag('tejo.svg', class: 'screen-shot', width: '75%'), 'https://www.tejo.org', target: :_blank %>
    </div>
  </div>
</div>

<div class="full_rectangle bg-color-grayLighter align-items-center">
  <div class="row">
    <div class="col-12 mb-5">
      <h3 class="title"><%= t("home.about.advantages.title") %></h3>
    </div>
    <div class="col-md mb-3">
      <div class="title"><%= t("home.about.advantages.files_title") %></div>
      <p><%= t("home.about.advantages.files_p") %></p>
    </div>
    <div class="col-md mb-3">
      <div class="title"><%= t("home.about.advantages.social_title") %></div>
      <p><%= t("home.about.advantages.social_p") %></p>
    </div>
    <div class="col-md mb-3">
      <div class="title"><%= t("home.about.advantages.open_source_title") %></div>
      <p>
        <%= t("home.about.advantages.open_source_p_html",
              github_link: link_to("GitHub", "https://github.com/eventaservo/eventaservo", target: :_blank),
              contact_link: mail_to("kontakto@eventaservo.org", t("home.about.advantages.contact_us"), subject: t("home.about.advantages.contact_subject"))) %>
      </p>
    </div>
    <div class="col-md mb-3">
      <div class="title"><%= t("home.about.advantages.tech_title") %></div>
      <p><%= t("home.about.advantages.tech_p") %></p>
    </div>
  </div>
</div>

<div class="full_rectangle bg-color-white align-items-center">
  <div class="col-12">
    <h3 class="title"><%= t("home.about.partners.title") %></h3>
    <p><%= t("home.about.partners.p") %></p>
    <div class="d-flex justify-content-around flex-wrap align-items-center">
      <%= link_to(image_tag('jetbrains.svg', width: 128, alt: 'Jetbrains'), 'http://jetbrains.com', target: :_blank) %>
      <%= link_to(image_tag('sentry.svg', width: 128, alt: 'Sentry'), 'https://sentry.io', target: :_blank) %>
      <%= link_to(image_tag('github.svg', width: 128, alt: 'Github'), 'https://github.com/eventaservo', target: :_blank) %>
      <%= link_to(image_tag('lokalise.png', width: 128, alt: 'Lokalise'), 'https://lokalise.com', target: :_blank) %>
    </div>
  </div>
</div>

<div class="text-end mt-3">
  <p class="small">
    <%= t("home.about.creator_company") %>
    <br>
    Kosmotek Tecnologia da Informação LTDA
    <br>
    CNPJ 45.619.066/0001-00
    <br>
    AV. Brigadeiro Faria Lima, 2369 - Conj. 1102
    <br>
    01452-922 - São Paulo - SP - Brazilo
    <br>
    fernando@eventaservo.org
  </p>
</div>

<div class="box-white">
  <div class="d-flex">
    <h1><%= t("search.title") %></h1>
  </div>

  <%= form_with url: serchilo_path, method: :get, data: {controller: "search-filters"} do |form| %>
    <div class="row">
      <div class="col-12 col-md-9">
        <div class="input-group">
          <input
            type="text"
            autofocus="true"
            value="<%= @search_term %>"
            name="query"
            placeholder="<%= t('search.placeholder') %>"
            aria-label="<%= t('search.query_aria_label') %>"
            class="form-control <%= 'is-invalid' unless @search_is_valid %>"
            >
            <%= form.submit '🔎', class: 'btn btn-outline-primary' %>

            <% unless @search_is_valid %>
              <div class="invalid-feedback d-inline"><%= t('search.min_chars_error') %></div>
            <% end %>

          </div>
        </div>

        <div class="col-12 col-md-3">
          <div class="d-sm-flex justify-content-around flex-md-column">
            <div class="form-check form-switch">
              <%= check_box_tag :pasintaj, true, params[:pasintaj], class: "form-check-input", data: {action: "change->search-filters#submit"} %>
              <%= label_tag :pasintaj, t('search.past'), class: 'form-check-label' %>
            </div>

            <div class="form-check form-switch">
              <%= check_box_tag :nuligitaj, true, params[:nuligitaj], class: "form-check-input", data: {action: "change->search-filters#submit"} %>
              <%= label_tag :nuligitaj, t('search.cancelled'), class: 'form-check-label' %>
            </div>
          </div>
        </div>
      </div>

      <% if @search_is_valid %>
        <%= render partial: "home/search/organizations_results", locals: { organizations: @organizations } %>
        <%= render partial: "home/search/events_results", locals: { events: @events } %>
        <%= render partial: "home/search/users_results", locals: { users: @users } %>
        <%= render partial: "home/search/videos_results", locals: { videos: @videos } %>
      <% end %>
    <% end %>
  </div>

<%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
  <% panel.with_body(class: "tw:space-y-4") do %>
    <h1 class="tw:text-2xl tw:font-bold tw:text-gray-900 tw:m-0"><%= t("search.title") %></h1>

    <%= form_with url: serchilo_path, method: :get, data: { controller: "search-filters" }, class: "tw:space-y-4" do %>
      <div class="tw:grid tw:grid-cols-1 tw:md:grid-cols-12 tw:gap-4 tw:items-start">
        <div class="tw:md:col-span-9 tw:space-y-3">
          <div>
            <div class="tw:flex tw:items-stretch tw:gap-2">
              <div class="tw:flex-1">
                <%= render Ui::InputComponent.new(
                  :query,
                  id: "query",
                  value: @search_term,
                  autofocus: true,
                  placeholder: t("search.placeholder"),
                  error: (@search_is_valid ? nil : t("search.min_chars_error")),
                  aria: { label: t("search.query_aria_label") }
                ) %>
              </div>
              <%= render Ui::ButtonComponent.new("🔎", type: :submit, variant: :outline_primary, class: "tw:self-start") %>
            </div>
          </div>

          <div class="tw:grid tw:grid-cols-2 tw:md:grid-cols-3 tw:gap-2">
            <div>
              <%= render Ui::InputComponent.new(
                :from,
                id: "from",
                type: :date,
                size: :small,
                label: t("search.from_date"),
                value: params[:from],
                aria: { label: t("search.from_date") }
              ) %>
            </div>

            <div>
              <%= render Ui::InputComponent.new(
                :to,
                id: "to",
                type: :date,
                size: :small,
                label: t("search.to_date"),
                value: params[:to],
                aria: { label: t("search.to_date") }
              ) %>
            </div>
          </div>
        </div>

        <div class="tw:md:col-span-3 tw:flex tw:flex-wrap tw:md:flex-col tw:gap-3 tw:pt-1">
          <%= render Ui::CheckboxComponent.new(
            :pasintaj,
            id: "pasintaj",
            value: "true",
            checked: params[:pasintaj].present?,
            label: t("search.past"),
            data: { action: "change->search-filters#submit" }
          ) %>

          <%= render Ui::CheckboxComponent.new(
            :nuligitaj,
            id: "nuligitaj",
            value: "true",
            checked: params[:nuligitaj].present?,
            label: t("search.cancelled"),
            data: { action: "change->search-filters#submit" }
          ) %>
        </div>
      </div>

      <% if @search_is_valid %>
        <div class="tw:space-y-4">
          <%= render partial: "home/search/organizations_results", locals: { organizations: @organizations } %>
          <%= render partial: "home/search/events_results", locals: { events: @events } %>
          <%= render partial: "home/search/users_results", locals: { users: @users } %>
          <%= render partial: "home/search/videos_results", locals: { videos: @videos } %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>

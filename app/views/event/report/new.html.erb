<div class="row mt-3">
  <div class="col-12 col-lg-9">
    <%= form_with(model: @report) do |f| %>
      <div class="box-white">
        <h1 class="lead"><%= t("events.reports.new_title") %></h1>

        <%= error_handling(@report) %>

        <br>

        <div class="field">
          <%= f.label :url %>
          <%= f.text_field :url, class: 'form-control', required: true, autofocus: true %>
          <small class="form-text text-muted"><%= t("events.reports.url_example") %></small>
        </div>

        <br>

        <div class="mb-3">
          <%= f.label :title %>
          <%= f.text_field :title, class: 'form-control', required: true %>
        </div>

        <div class="buttons-footer">
          <%= link_to t("buttons.cancel_registration"), event_path(code: @event.code), class: 'button-cancel' %>
          <%= f.submit t("buttons.save_event"), class: 'button-submit' %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="col-12 col-lg-3">
    <div class="mt-1">
      <%= render partial: "/events/card", locals: { event: @event } %>
    </div>
  </div>
</div>

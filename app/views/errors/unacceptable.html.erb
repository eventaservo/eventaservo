<div class="tw:w-full tw:md:w-1/2 tw:mx-auto tw:my-4">
  <%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
    <% panel.with_body(class: "tw:space-y-4") do %>
      <h1 class="tw:text-2xl tw:font-bold tw:text-gray-900 tw:m-0"><%= t("errors.unacceptable.title") %></h1>
      <p class="tw:text-sm tw:text-gray-700 tw:m-0">
        <%= t("errors.unacceptable.message") %>
      </p>
      <div>
        <%= render Ui::ButtonComponent.new(t("errors.not_found.back_to_home"), href: root_url, variant: :primary, full_width: true) %>
      </div>
    <% end %>
  <% end %>
</div>

<div class="box-white col-12 col-md-6 mx-auto">
  <h1><%= t("errors.internal_error.title") %></h1>
  <p>
    <%= t("errors.internal_error.apology") %>
  </p>

  <p>
    <%= t("errors.internal_error.help_us") %>
  </p>

  <%= form_tag error_form_url, method: :post do %>
    <% if current_user %>
      <%= hidden_field_tag :name, current_user.name %>
      <%= hidden_field_tag :email, current_user.email %>
      <%= hidden_field_tag :sentry_event_id, @sentry_id %>
    <% else %>
      <div class="mb-3">
        <%= label_tag :name, t("errors.internal_error.form.name") %>
        <%= text_field_tag :name, "", autocomplete: "name", class: "form-control", required: true, autofocus: true %>
      </div>
      <div class="mb-3">
        <%= label_tag :email, t("errors.internal_error.form.email") %>
        <%= text_field_tag :email, "", autocomplete: "email", class: "form-control", required: true %>
      </div>
    <% end %>

    <div class="mb-3">
      <%= label_tag :comments, t("errors.internal_error.form.comments") %>
      <%= text_area_tag :comments, nil, class: "form-control", rows: 4, required: true, autofocus: true %>
    </div>

    <div class="buttons-footer">
      <%= link_to t("errors.internal_error.form.back_to_home"), root_url, class: "button-cancel" %>
      <%= submit_tag t("errors.internal_error.form.submit"), class: "button-submit" %>
    </div>
  <% end %>
</div>

<%= render "admin/shared/breadcrumb", items: [["Organizaĵoj"]] %>

<%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
  <% panel.with_body(class: "tw:space-y-4") do %>
    <h1 class="tw:text-xl tw:font-bold tw:text-gray-900 tw:pb-2 tw:border-b tw:border-gray-200 tw:m-0">Ĉiuj organizaĵoj</h1>

    <%= form_with url: admin_organizations_path, method: :get, local: true do %>
      <div class="tw:grid tw:grid-cols-1 tw:md:grid-cols-12 tw:gap-2 tw:items-end">
        <div class="tw:md:col-span-5">
          <%= render Ui::InputComponent.new(:name_cont, id: "name_cont", size: :small, label: "NOMO", value: params[:name_cont], placeholder: "Serĉi nomon...") %>
        </div>
        <div class="tw:md:col-span-4">
          <%= render Ui::SelectComponent.new(
            :country_id_eq,
            id: "country_id_eq",
            size: :small,
            label: "LANDO",
            options: @countries.map { |country| [country.name, country.id] },
            selected: params[:country_id_eq],
            include_blank: "Ĉiuj"
          ) %>
        </div>
        <div class="tw:md:col-span-3 tw:flex tw:items-center tw:gap-2">
          <%= render Ui::ButtonComponent.new("Filtri", type: :submit, variant: :success, size: :small) %>
          <%= render Ui::ButtonComponent.new("Nuligi", href: admin_organizations_path, variant: :secondary, size: :small) %>
        </div>
      </div>
    <% end %>

    <div class="tw:border tw:border-gray-200 tw:rounded tw:overflow-hidden tw:text-xs">
      <div class="tw:grid tw:grid-cols-12 tw:gap-2 tw:items-center tw:bg-esperanto-500 tw:text-white tw:uppercase tw:font-bold tw:px-3 tw:py-2 tw:text-[11px]">
        <div class="tw:col-span-5">Nomo</div>
        <div class="tw:col-span-3">Mallonga nomo</div>
        <div class="tw:col-span-3">Lando</div>
        <div class="tw:col-span-1 tw:text-right">Agoj</div>
      </div>

      <% @organizations.each_with_index do |organization, i| %>
        <% stripe_classes = [
          ("tw:border-b tw:border-gray-200" unless i == @organizations.size - 1),
          ("tw:bg-gray-50" if i.odd?)
        ].compact.join(" ") %>

        <div class="tw:grid tw:grid-cols-12 tw:gap-2 tw:items-center tw:px-3 tw:py-1.5 tw:text-gray-900 tw:hover:bg-esperanto-50 tw:transition-colors <%= stripe_classes %>">
          <div class="tw:col-span-5 tw:font-medium tw:truncate">
            <%= link_to organization.name, organization_path(short_name: organization.short_name), class: "tw:text-gray-900 tw:no-underline tw:hover:text-esperanto-600" %>
          </div>
          <div class="tw:col-span-3 tw:text-gray-600 tw:truncate"><%= organization.short_name %></div>
          <div class="tw:col-span-3 tw:text-gray-600 tw:truncate">
            <%= flag_icon(organization.country&.code) if organization.country&.code %>
            <%= organization.country&.name %>
          </div>
          <div class="tw:col-span-1 tw:text-right">
            <%= render Ui::ButtonComponent.new("Forigi", href: delete_admin_organization_path(organization), variant: :danger, size: :small) %>
          </div>
        </div>
      <% end %>

      <% if @organizations.empty? %>
        <div class="tw:p-6 tw:text-center tw:text-gray-500">
          <%= icon("fas", "search", class: "fa-2x tw:mb-3 tw:opacity-25") %>
          <p class="tw:m-0">Neniu organizaĵo trovita.</p>
        </div>
      <% end %>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
<% end %>

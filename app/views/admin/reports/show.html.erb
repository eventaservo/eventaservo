<%= render "admin/shared/breadcrumb", items: [["Raportoj", admin_reports_path], ["Detaloj"]] %>

<%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
  <% panel.with_body(class: "tw:space-y-5") do %>
    <h1 class="tw:text-xl tw:font-bold tw:text-gray-900 tw:pb-2 tw:border-b tw:border-gray-200 tw:m-0">Raportaj Detaloj</h1>

    <div class="tw:grid tw:grid-cols-1 tw:md:grid-cols-12 tw:gap-6">
      <div class="tw:md:col-span-8 tw:space-y-4">
        <div>
          <div class="tw:text-[11px] tw:uppercase tw:font-bold tw:text-gray-500 tw:mb-1">Titolo</div>
          <div class="tw:text-lg tw:font-semibold tw:text-gray-900"><%= @report.title %></div>
        </div>

        <div>
          <div class="tw:text-[11px] tw:uppercase tw:font-bold tw:text-gray-500 tw:mb-1">URL</div>
          <div><%= link_to @report.url, @report.url, target: "_blank", rel: "noopener", class: "tw:text-brand-blue tw:hover:text-brand-blue-hover tw:break-all" %></div>
        </div>

        <div>
          <div class="tw:text-[11px] tw:uppercase tw:font-bold tw:text-gray-500 tw:mb-1">Evento</div>
          <div>
            <%= link_to @report.event.title, event_path(code: @report.event.ligilo), target: "_blank", rel: "noopener", class: "tw:font-medium tw:text-brand-blue tw:hover:text-brand-blue-hover" %>
          </div>
        </div>
      </div>

      <div class="tw:md:col-span-4 tw:md:border-l tw:md:border-gray-200 tw:md:pl-6 tw:space-y-4">
        <div>
          <div class="tw:text-[11px] tw:uppercase tw:font-bold tw:text-gray-500 tw:mb-1">Raportanto</div>
          <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-1.5 tw:text-sm tw:text-gray-900">
            <span><%= @report.user&.name %></span>
            <span class="tw:text-gray-500 tw:text-xs">(<%= @report.user&.username %>)</span>
          </div>
        </div>

        <div>
          <div class="tw:text-[11px] tw:uppercase tw:font-bold tw:text-gray-500 tw:mb-1">Kreita je</div>
          <div class="tw:text-gray-600 tw:text-xs">
            <%= l(@report.created_at, format: :long) %>
          </div>
        </div>
      </div>
    </div>

    <div class="tw:pt-4 tw:border-t tw:border-gray-200 tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-2">
      <%= render Ui::ButtonComponent.new("Redakti", href: edit_admin_report_path(@report), icon: "edit", variant: :success) %>
      <%= render Ui::ButtonComponent.new(
        "Forigi",
        href: admin_report_path(@report),
        icon: "trash",
        variant: :outline_danger,
        data: { method: :delete, confirm: "Ĉu vi estas certa?" }
      ) %>
    </div>
  <% end %>
<% end %>

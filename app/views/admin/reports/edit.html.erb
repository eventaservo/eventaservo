<%= render "admin/shared/breadcrumb", items: [["Raportoj", admin_reports_path], ["Detaloj", admin_report_path(@report)], ["Redakti"]] %>

<%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
  <% panel.with_body(class: "tw:space-y-4") do %>
    <h1 class="tw:text-xl tw:font-bold tw:text-gray-900 tw:pb-2 tw:border-b tw:border-gray-200 tw:m-0">Redakti Raporton</h1>
    <%= render "form", report: @report %>
  <% end %>
<% end %>

<%= form_with(model: report, url: admin_report_path(report), local: true, class: "tw:space-y-4") do %>
  <%= error_handling(report) %>

  <%= render Ui::InputComponent.new("event_report[title]", id: "event_report_title", label: "TITOLO DE LA RAPORTO", value: report.title) %>

  <%= render Ui::InputComponent.new("event_report[url]", id: "event_report_url", label: "URL DE LA RAPORTO", value: report.url) %>

  <%= render Ui::SelectComponent.new(
    "event_report[user_id]",
    id: "event_report_user_id",
    label: "RAPORTANTO (UZANTO)",
    options: @users.map { |user| [user.name, user.id] },
    selected: report.user_id
  ) %>

  <div class="tw:pt-2 tw:flex tw:items-center tw:gap-2">
    <%= render Ui::ButtonComponent.new("Konservi", type: :submit, variant: :success) %>
    <%= render Ui::ButtonComponent.new("Nuligi", href: admin_report_path(report), variant: :secondary) %>
  </div>
<% end %>

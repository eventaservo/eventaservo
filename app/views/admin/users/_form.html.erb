<%= form_with(model: user, url: admin_user_path(user), local: true, class: "tw:space-y-4") do %>
  <%= error_handling(user) %>

  <%= render Ui::InputComponent.new("user[name]", id: "user_name", label: "NAME", value: user.name) %>

  <%= render Ui::SelectComponent.new(
    "user[country_id]",
    id: "user_country_id",
    label: "COUNTRY",
    options: Country.order(:name).map { |country| [country.name, country.id] },
    selected: user.country_id
  ) %>

  <%= render Ui::InputComponent.new("user[city]", id: "user_city", label: "CITY", value: user.city) %>

  <div class="tw:pt-2 tw:flex tw:items-center tw:gap-2">
    <%= render Ui::ButtonComponent.new("Save", type: :submit, variant: :success) %>
    <%= render Ui::ButtonComponent.new("Cancel", href: admin_user_path(user), variant: :secondary) %>
  </div>
<% end %>

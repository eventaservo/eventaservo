<%= render "admin/shared/breadcrumb", items: [["Users", admin_users_path], [@user.name, admin_user_path(@user)], ["Merge"]] %>

<%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
  <% panel.with_body(class: "tw:space-y-4") do %>
    <h1 class="tw:text-xl tw:font-bold tw:text-gray-900 tw:pb-2 tw:border-b tw:border-gray-200 tw:m-0">Merge Users</h1>

    <%= render Ui::AlertComponent.new(variant: :warning, icon: true) do %>
      <strong>Warning:</strong> This will transfer all events, organization memberships, and logs from
      <strong><%= @user.name %></strong> to the selected target user, then delete this account.
      This action cannot be undone.
    <% end %>

    <%= form_with url: merge_admin_user_path(@user), method: :post, local: true, class: "tw:space-y-4" do %>
      <%= render Ui::SelectComponent.new(
        "merge_users[target_user_id]",
        id: "merge_users_target_user_id",
        label: "TRANSFER EVERYTHING TO",
        options: @user_list,
        required: true
      ) %>

      <div class="tw:pt-2 tw:flex tw:items-center tw:gap-2">
        <%= render Ui::ButtonComponent.new(
          "Merge",
          type: :submit,
          variant: :danger,
          data: { confirm: "Are you absolutely sure? This cannot be undone." }
        ) %>
        <%= render Ui::ButtonComponent.new("Cancel", href: admin_user_path(@user), variant: :secondary) %>
      </div>
    <% end %>
  <% end %>
<% end %>

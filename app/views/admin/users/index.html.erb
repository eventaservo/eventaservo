<%= render "admin/shared/breadcrumb", items: [["Users"]] %>

<%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
  <% panel.with_body(class: "tw:space-y-4") do %>
    <h1 class="tw:text-xl tw:font-bold tw:text-gray-900 tw:pb-2 tw:border-b tw:border-gray-200 tw:m-0">Users</h1>

    <%# ── Scopes ──────────────────────────────────────────── %>
    <div class="tw:flex tw:flex-wrap tw:gap-2">
      <% scopes = [["Enabled", "enabled"], ["Disabled", "disabled"], ["Abandoned", "abandoned"], ["Not confirmed", "not_confirmed"]] %>
      <% current_scope = params[:scope].presence || "enabled" %>
      <% scopes.each do |label, scope| %>
        <%= render Ui::ButtonComponent.new(
          label,
          href: admin_users_path(scope: scope),
          variant: (current_scope == scope) ? :success : :secondary,
          size: :small
        ) %>
      <% end %>
    </div>

    <%# ── Filters ─────────────────────────────────────────── %>
    <%= form_with url: admin_users_path, method: :get, local: true do %>
      <%= hidden_field_tag :scope, params[:scope] %>
      <div class="tw:grid tw:grid-cols-1 tw:sm:grid-cols-2 tw:lg:grid-cols-12 tw:gap-2 tw:items-end">
        <div class="tw:lg:col-span-2">
          <%= render Ui::InputComponent.new(:name, id: "name", size: :small, label: "NAME", value: params[:name], placeholder: "Search name...") %>
        </div>
        <div class="tw:lg:col-span-3">
          <%= render Ui::InputComponent.new(:email, id: "email", size: :small, label: "EMAIL", value: params[:email], placeholder: "Search email...") %>
        </div>
        <div class="tw:lg:col-span-2">
          <%= render Ui::InputComponent.new(:username, id: "username", size: :small, label: "USERNAME", value: params[:username], placeholder: "Search username...") %>
        </div>
        <div class="tw:lg:col-span-3">
          <%= render Ui::SelectComponent.new(
            :country_id,
            id: "country_id",
            size: :small,
            label: "COUNTRY",
            options: Country.order(:name).map { |country| [country.name, country.id] },
            selected: params[:country_id]&.to_i,
            include_blank: "All countries"
          ) %>
        </div>
        <div class="tw:sm:col-span-2 tw:lg:col-span-2 tw:flex tw:items-center tw:gap-2">
          <%= render Ui::ButtonComponent.new("Filter", type: :submit, variant: :success, size: :small) %>
          <%= render Ui::ButtonComponent.new("Clear", href: admin_users_path(scope: params[:scope]), variant: :secondary, size: :small) %>
        </div>
      </div>
    <% end %>

    <%# ── List ────────────────────────────────────────────── %>
    <div class="tw:border tw:border-gray-200 tw:rounded tw:overflow-hidden tw:text-xs">
      <div class="tw:grid tw:grid-cols-12 tw:gap-2 tw:items-center tw:bg-esperanto-500 tw:text-white tw:uppercase tw:font-bold tw:px-3 tw:py-2 tw:text-[11px]">
        <div class="tw:col-span-5 tw:md:col-span-3">Name</div>
        <div class="tw:col-span-5 tw:md:col-span-3">Email</div>
        <div class="tw:hidden tw:md:block tw:md:col-span-1">City</div>
        <div class="tw:hidden tw:md:block tw:md:col-span-2">Country</div>
        <div class="tw:hidden tw:md:block tw:md:col-span-1">Username</div>
        <div class="tw:hidden tw:md:block tw:md:col-span-1">Events</div>
        <div class="tw:col-span-2 tw:md:col-span-1">Active?</div>
      </div>

      <% @users.each_with_index do |user, i| %>
        <% stripe_classes = [
          ("tw:border-b tw:border-gray-200" unless i == @users.size - 1),
          ("tw:bg-gray-50" if i.odd?)
        ].compact.join(" ") %>

        <%= link_to admin_user_path(user), class: "tw:grid tw:grid-cols-12 tw:gap-2 tw:items-center tw:px-3 tw:py-1.5 tw:text-gray-900 tw:no-underline tw:hover:bg-esperanto-50 tw:transition-colors #{stripe_classes}" do %>
          <div class="tw:col-span-5 tw:md:col-span-3 tw:font-medium tw:text-gray-900 tw:break-words"><%= user.name %></div>
          <div class="tw:col-span-5 tw:md:col-span-3 tw:text-gray-600 tw:break-all"><%= user.email %></div>
          <div class="tw:hidden tw:md:block tw:md:col-span-1 tw:text-gray-600 tw:truncate"><%= user.city %></div>
          <div class="tw:hidden tw:md:block tw:md:col-span-2 tw:text-gray-600 tw:truncate"><%= display_flag(user.country) %> <%= user.country&.name %></div>
          <div class="tw:hidden tw:md:block tw:md:col-span-1 tw:text-gray-600 tw:truncate"><%= user.username %></div>
          <div class="tw:hidden tw:md:block tw:md:col-span-1 tw:text-gray-600"><%= user.events_count %></div>
          <div class="tw:col-span-2 tw:md:col-span-1">
            <% if user.active? %>
              <%= render Ui::BadgeComponent.new("Yes", variant: :success, shape: :rounded, size: :small) %>
            <% else %>
              <%= render Ui::BadgeComponent.new("No", variant: :danger, shape: :rounded, size: :small) %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% if @users.empty? %>
        <div class="tw:p-6 tw:text-center tw:text-gray-500">
          <%= icon("fas", "search", class: "fa-2x tw:mb-3 tw:opacity-25") %>
          <p class="tw:m-0">No users found.</p>
        </div>
      <% end %>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
<% end %>

<%= render "admin/shared/breadcrumb", items: [["Users", admin_users_path], [@user.name]] %>

<div class="tw:space-y-4">
  <%# ── Header Panel ──────────────────────────────────────── %>
  <%= render Ui::CardComponent.new(variant: :bordered, flush: true) do |panel| %>
    <% panel.with_body(padding: false) do %>
      <div class="<%= @user.disabled? ? "tw:bg-red-50" : "tw:bg-esperanto-50" %> tw:border-b tw:border-gray-200 tw:px-5 tw:py-5">
        <div class="tw:flex tw:flex-col tw:sm:flex-row tw:sm:items-center tw:gap-4">
          <div class="tw:w-16 tw:h-16 tw:rounded-full tw:bg-gray-200 tw:flex tw:items-center tw:justify-center tw:shrink-0">
            <i class="fas fa-user fa-lg tw:text-gray-500" aria-hidden="true"></i>
          </div>

          <div class="tw:flex-1 tw:min-w-0">
            <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-2 tw:mb-1">
              <h1 class="tw:text-lg tw:font-bold tw:text-gray-900 tw:m-0"><%= @user.name %></h1>
              <% if @user.admin? %>
                <%= render Ui::BadgeComponent.new("Admin", variant: :warning, shape: :rounded, size: :small) %>
              <% end %>
              <% if @user.disabled? %>
                <%= render Ui::BadgeComponent.new("Disabled", variant: :danger, shape: :rounded, size: :small) %>
              <% end %>
              <% if @user.active? %>
                <%= render Ui::BadgeComponent.new("Active", variant: :success, shape: :rounded, size: :small) %>
              <% else %>
                <%= render Ui::BadgeComponent.new("Inactive", variant: :danger, shape: :rounded, size: :small) %>
              <% end %>
            </div>
            <div class="tw:text-xs tw:text-gray-600 tw:flex tw:flex-wrap tw:items-center tw:gap-x-1.5 tw:gap-y-0.5">
              <span>@<%= @user.username %></span>
              <span>&middot;</span>
              <span class="tw:break-all"><%= @user.email %></span>
              <span>&middot;</span>
              <span><%= display_flag(@user.country) %> <%= @user.country&.name %></span>
            </div>
          </div>

          <div class="tw:flex tw:flex-wrap tw:gap-2 tw:shrink-0">
            <%= render Ui::ButtonComponent.new("Profile", href: events_by_username_path(username: @user.username), icon: "external-link-alt", variant: :secondary, size: :small, target: "_blank", rel: "noopener") %>
            <%= render Ui::ButtonComponent.new("Edit", href: edit_admin_user_path(@user), icon: "edit", variant: :success, size: :small) %>
          </div>
        </div>
      </div>

      <%# ── Quick Stats ──────────────────────────────────────── %>
      <div class="tw:grid tw:grid-cols-2 tw:sm:grid-cols-4 tw:divide-y tw:sm:divide-y-0 tw:sm:divide-x tw:divide-gray-200">
        <div class="tw:text-center tw:py-3 tw:px-2">
          <div class="tw:text-2xl tw:font-bold tw:text-esperanto-500"><%= @user.events_count %></div>
          <div class="tw:text-[11px] tw:uppercase tw:tracking-wider tw:font-semibold tw:text-gray-400">Events</div>
        </div>
        <div class="tw:text-center tw:py-3 tw:px-2">
          <div class="tw:text-2xl tw:font-bold tw:text-esperanto-500"><%= @user.organizations.count %></div>
          <div class="tw:text-[11px] tw:uppercase tw:tracking-wider tw:font-semibold tw:text-gray-400">Organizations</div>
        </div>
        <div class="tw:text-center tw:py-3 tw:px-2">
          <div class="tw:text-2xl tw:font-bold tw:text-esperanto-500"><%= @user.sign_in_count %></div>
          <div class="tw:text-[11px] tw:uppercase tw:tracking-wider tw:font-semibold tw:text-gray-400">Sign-ins</div>
        </div>
        <div class="tw:text-center tw:py-3 tw:px-2">
          <div class="tw:text-sm tw:font-bold tw:text-gray-600 tw:mt-1"><%= @user.created_at.present? ? l(@user.created_at, format: :short) : "—" %></div>
          <div class="tw:text-[11px] tw:uppercase tw:tracking-wider tw:font-semibold tw:text-gray-400">Joined</div>
        </div>
      </div>
    <% end %>
  <% end %>

  <div class="tw:grid tw:grid-cols-1 tw:md:grid-cols-2 tw:gap-4">
    <%# ── Personal Information ────────────────────────────────── %>
    <%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
      <% panel.with_body(class: "tw:space-y-3") do %>
        <h2 class="tw:text-[11px] tw:uppercase tw:tracking-wider tw:font-semibold tw:text-gray-400 tw:m-0 tw:flex tw:items-center tw:gap-1.5">
          <i class="fas fa-id-card" aria-hidden="true"></i>
          <span>Personal Information</span>
        </h2>

        <dl class="tw:divide-y tw:divide-gray-100 tw:text-xs tw:m-0">
          <div class="tw:grid tw:grid-cols-3 tw:gap-2 tw:py-1.5">
            <dt class="tw:font-semibold tw:text-gray-500">ID</dt>
            <dd class="tw:col-span-2 tw:text-gray-900 tw:m-0"><%= @user.id %></dd>
          </div>
          <div class="tw:grid tw:grid-cols-3 tw:gap-2 tw:py-1.5">
            <dt class="tw:font-semibold tw:text-gray-500">Email</dt>
            <dd class="tw:col-span-2 tw:text-gray-900 tw:m-0 tw:break-all"><%= @user.email %></dd>
          </div>
          <div class="tw:grid tw:grid-cols-3 tw:gap-2 tw:py-1.5">
            <dt class="tw:font-semibold tw:text-gray-500">Username</dt>
            <dd class="tw:col-span-2 tw:text-gray-900 tw:m-0">@<%= @user.username %></dd>
          </div>
          <div class="tw:grid tw:grid-cols-3 tw:gap-2 tw:py-1.5">
            <dt class="tw:font-semibold tw:text-gray-500">City</dt>
            <dd class="tw:col-span-2 tw:text-gray-900 tw:m-0"><%= @user.city.presence || "—" %></dd>
          </div>
          <div class="tw:grid tw:grid-cols-3 tw:gap-2 tw:py-1.5">
            <dt class="tw:font-semibold tw:text-gray-500">Country</dt>
            <dd class="tw:col-span-2 tw:text-gray-900 tw:m-0"><%= display_flag(@user.country) %> <%= @user.country&.name || "—" %></dd>
          </div>
          <div class="tw:grid tw:grid-cols-3 tw:gap-2 tw:py-1.5">
            <dt class="tw:font-semibold tw:text-gray-500">Birthday</dt>
            <dd class="tw:col-span-2 tw:text-gray-900 tw:m-0"><%= @user.birthday.present? ? l(@user.birthday, format: :long) : "—" %></dd>
          </div>
          <div class="tw:grid tw:grid-cols-3 tw:gap-2 tw:py-1.5">
            <dt class="tw:font-semibold tw:text-gray-500">UEA Code</dt>
            <dd class="tw:col-span-2 tw:text-gray-900 tw:m-0"><%= @user.ueacode.presence || "—" %></dd>
          </div>
          <div class="tw:grid tw:grid-cols-3 tw:gap-2 tw:py-1.5">
            <dt class="tw:font-semibold tw:text-gray-500">About</dt>
            <dd class="tw:col-span-2 tw:text-gray-900 tw:m-0 tw:break-words"><%= @user.about.presence || "—" %></dd>
          </div>
          <div class="tw:grid tw:grid-cols-3 tw:gap-2 tw:py-1.5">
            <dt class="tw:font-semibold tw:text-gray-500">Webcal Token</dt>
            <dd class="tw:col-span-2 tw:m-0"><code class="tw:text-gray-600 tw:break-all"><%= @user.webcal_token %></code></dd>
          </div>
        </dl>
      <% end %>
    <% end %>

    <%# ── Account & Organizations ─────────────────────────────── %>
    <div class="tw:space-y-4">
      <%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
        <% panel.with_body(class: "tw:space-y-3") do %>
          <h2 class="tw:text-[11px] tw:uppercase tw:tracking-wider tw:font-semibold tw:text-gray-400 tw:m-0 tw:flex tw:items-center tw:gap-1.5">
            <i class="fas fa-shield-alt" aria-hidden="true"></i>
            <span>Account Status</span>
          </h2>

          <dl class="tw:divide-y tw:divide-gray-100 tw:text-xs tw:m-0">
            <div class="tw:grid tw:grid-cols-3 tw:gap-2 tw:py-1.5">
              <dt class="tw:font-semibold tw:text-gray-500">Confirmed at</dt>
              <dd class="tw:col-span-2 tw:text-gray-900 tw:m-0">
                <% if @user.confirmed_at.present? %>
                  <%= l(@user.confirmed_at, format: :long) %>
                <% else %>
                  <%= render Ui::BadgeComponent.new("Not confirmed", variant: :danger, shape: :rounded, size: :small) %>
                <% end %>
              </dd>
            </div>
            <div class="tw:grid tw:grid-cols-3 tw:gap-2 tw:py-1.5">
              <dt class="tw:font-semibold tw:text-gray-500">Last sign in</dt>
              <dd class="tw:col-span-2 tw:text-gray-900 tw:m-0"><%= @user.last_sign_in_at.present? ? l(@user.last_sign_in_at, format: :long) : "—" %></dd>
            </div>
          </dl>
        <% end %>
      <% end %>

      <% if @user.organizations.any? %>
        <%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
          <% panel.with_body(class: "tw:space-y-3") do %>
            <h2 class="tw:text-[11px] tw:uppercase tw:tracking-wider tw:font-semibold tw:text-gray-400 tw:m-0 tw:flex tw:items-center tw:gap-1.5">
              <i class="fas fa-sitemap" aria-hidden="true"></i>
              <span>Organizations</span>
            </h2>

            <div class="tw:flex tw:flex-wrap tw:gap-2">
              <% @user.organizations.each do |org| %>
                <%= render Ui::BadgeComponent.new(
                  org.name,
                  href: organization_path(short_name: org.short_name),
                  icon: "building",
                  variant: :success,
                  shape: :rounded,
                  size: :medium,
                  target: "_blank"
                ) %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ── Actions ───────────────────────────────────────────── %>
  <%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
    <% panel.with_body(class: "tw:space-y-3") do %>
      <h2 class="tw:text-[11px] tw:uppercase tw:tracking-wider tw:font-semibold tw:text-gray-400 tw:m-0 tw:flex tw:items-center tw:gap-1.5">
        <i class="fas fa-bolt" aria-hidden="true"></i>
        <span>Actions</span>
      </h2>

      <div class="tw:flex tw:flex-wrap tw:gap-2">
        <% if @user.confirmed_at.nil? %>
          <%= render Ui::ButtonComponent.new(
            "Confirm email",
            href: confirm_admin_user_path(@user),
            icon: "check-circle",
            variant: :outline_primary,
            size: :small,
            method: :patch,
            data: { confirm: "This will confirm the user's email. Are you sure?" }
          ) %>
        <% end %>

        <% if @user.disabled? %>
          <%= render Ui::ButtonComponent.new(
            "Enable",
            href: enable_admin_user_path(@user),
            icon: "user-check",
            variant: :success,
            size: :small,
            method: :patch,
            data: { confirm: "Re-enable this deleted user. Are you sure?" }
          ) %>
        <% end %>

        <% unless @user.disabled? %>
          <%= render Ui::ButtonComponent.new(
            "Deactivate",
            href: deactivate_admin_user_path(@user),
            icon: "user-slash",
            variant: :outline_danger,
            size: :small,
            method: :patch,
            data: { confirm: "This will remove the user from organizations, move all events to system account and disable the user. Are you sure?" }
          ) %>
        <% end %>

        <%= render Ui::ButtonComponent.new(
          "Merge",
          href: merge_admin_user_path(@user),
          icon: "object-group",
          variant: :secondary,
          size: :small
        ) %>

        <%= render Ui::ButtonComponent.new(
          "Reset password",
          href: reset_password_admin_user_path(@user),
          icon: "key",
          variant: :outline_danger,
          size: :small,
          method: :patch,
          data: { confirm: "This will change the user's password. Are you sure?" }
        ) %>
      </div>
    <% end %>
  <% end %>
</div>

<%= render "admin/shared/breadcrumb", items: [["Users", admin_users_path], [@user.name, admin_user_path(@user)], ["Edit"]] %>

<%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
  <% panel.with_body(class: "tw:space-y-4") do %>
    <h1 class="tw:text-xl tw:font-bold tw:text-gray-900 tw:pb-2 tw:border-b tw:border-gray-200 tw:m-0">Edit User</h1>
    <%= render "form", user: @user %>
  <% end %>
<% end %>

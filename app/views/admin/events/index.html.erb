<%= render "admin/shared/breadcrumb", items: [["Events"]] %>

<%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
  <% panel.with_body(class: "tw:space-y-4") do %>
    <h1 class="tw:text-xl tw:font-bold tw:text-gray-900 tw:pb-2 tw:border-b tw:border-gray-200 tw:m-0">Ĉiuj eventoj</h1>

    <%= form_with url: admin_events_path, method: :get, local: true do %>
      <div class="tw:grid tw:grid-cols-1 tw:sm:grid-cols-2 tw:lg:grid-cols-12 tw:gap-2 tw:items-end">
        <div class="tw:lg:col-span-2">
          <%= render Ui::InputComponent.new(:start_date, id: "start_date", type: :date, size: :small, label: "EKDE", value: params[:start_date]) %>
        </div>
        <div class="tw:lg:col-span-2">
          <%= render Ui::InputComponent.new(:end_date, id: "end_date", type: :date, size: :small, label: "ĜIS", value: params[:end_date]) %>
        </div>
        <div class="tw:lg:col-span-2">
          <%= render Ui::InputComponent.new(:title, id: "title", size: :small, label: "TITOLO", value: params[:title], placeholder: "Serĉi titolon...") %>
        </div>
        <div class="tw:lg:col-span-3">
          <%= render Ui::SelectComponent.new(
            :country_id,
            id: "country_id",
            size: :small,
            label: "LANDO",
            options: @countries.map { |country| [country.name, country.id] },
            selected: params[:country_id],
            include_blank: "Ĉiuj"
          ) %>
        </div>
        <div class="tw:lg:col-span-3">
          <%= render Ui::SelectComponent.new(
            :organization_id,
            id: "organization_id",
            size: :small,
            label: "ORGANIZAĴO",
            options: @organizations.map { |org| [org.name, org.id] },
            selected: params[:organization_id],
            include_blank: "Ĉiuj"
          ) %>
        </div>
        <div class="tw:sm:col-span-2 tw:lg:col-span-12 tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-3 tw:pt-1">
          <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-4">
            <%= render Ui::CheckboxComponent.new(:senlokaj, id: "senlokaj", size: :small, checked: params[:senlokaj] == "1", label: "SENLOKAJ") %>
            <%= render Ui::CheckboxComponent.new(:forigitaj, id: "forigitaj", size: :small, checked: params[:forigitaj] == "1", label: "FORIGITAJ") %>
          </div>
          <div class="tw:flex tw:items-center tw:gap-2">
            <%= render Ui::ButtonComponent.new("Filtri", type: :submit, variant: :success, size: :small) %>
            <%= render Ui::ButtonComponent.new("Nuligi", href: admin_events_path, variant: :secondary, size: :small) %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="tw:border tw:border-gray-200 tw:rounded tw:overflow-hidden tw:text-xs">
      <div class="tw:grid tw:grid-cols-12 tw:gap-2 tw:items-center tw:bg-esperanto-500 tw:text-white tw:uppercase tw:font-bold tw:px-3 tw:py-2 tw:text-[11px]">
        <div class="tw:col-span-3 tw:sm:col-span-2">Dato</div>
        <div class="<%= @forigitaj ? 'tw:col-span-5 tw:sm:col-span-6' : 'tw:col-span-6 tw:sm:col-span-7' %>">Titolo</div>
        <div class="tw:col-span-3">Loko</div>
        <% if @forigitaj %><div class="tw:col-span-1 tw:text-right"></div><% end %>
      </div>

      <% @events.each_with_index do |event, i| %>
        <% stripe_classes = [
          ("tw:border-b tw:border-gray-200" unless i == @events.size - 1),
          ("tw:bg-gray-50" if i.odd?)
        ].compact.join(" ") %>

        <% if @forigitaj %>
          <div class="tw:grid tw:grid-cols-12 tw:gap-2 tw:items-center tw:px-3 tw:py-1.5 <%= stripe_classes %>">
            <div class="tw:col-span-3 tw:sm:col-span-2 tw:font-semibold tw:text-esperanto-600 tw:truncate"><%= format_date(event.komenca_dato, style: :compact) %></div>
            <div class="tw:col-span-5 tw:sm:col-span-6 tw:font-medium tw:text-gray-900 tw:truncate"><%= event.title %></div>
            <div class="tw:col-span-3 tw:text-gray-600 tw:truncate"><%= event_flag(event) %> <%= event.city %></div>
            <div class="tw:col-span-1 tw:text-right">
              <%= link_to icon("fas", "trash-restore"), admin_recover_event_path(event.ligilo), method: :patch, class: "tw:text-esperanto-500 tw:hover:text-esperanto-600", title: "Restaŭri", aria: { label: "Restaŭri" } %>
            </div>
          </div>
        <% else %>
          <%= link_to event_path(code: event.ligilo), class: "tw:grid tw:grid-cols-12 tw:gap-2 tw:items-center tw:px-3 tw:py-1.5 tw:text-gray-900 tw:no-underline tw:hover:bg-esperanto-50 tw:transition-colors #{stripe_classes}" do %>
            <div class="tw:col-span-3 tw:sm:col-span-2 tw:font-semibold tw:text-esperanto-600 tw:truncate"><%= format_date(event.komenca_dato, style: :compact) %></div>
            <div class="tw:col-span-6 tw:sm:col-span-7 tw:font-medium tw:text-gray-900 tw:truncate"><%= event.title %></div>
            <div class="tw:col-span-3 tw:text-gray-600 tw:truncate"><%= event_flag(event) %> <%= event.city %></div>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
<% end %>

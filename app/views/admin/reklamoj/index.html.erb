<%= render "admin/shared/breadcrumb", items: [["Reklamoj"]] %>

<%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
  <% panel.with_body(class: "tw:space-y-4") do %>
    <div class="tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-2 tw:pb-2 tw:border-b tw:border-gray-200">
      <h1 class="tw:text-xl tw:font-bold tw:text-gray-900 tw:m-0">Reklamoj</h1>
      <%= render Ui::ButtonComponent.new(
        "Nova reklamo",
        href: new_admin_reklamoj_url,
        icon: "plus-circle",
        variant: :new_link,
        size: :small,
        aria: { label: "Krei novan reklamon" }
      ) %>
    </div>

    <div class="tw:grid tw:grid-cols-1 tw:md:grid-cols-2 tw:lg:grid-cols-3 tw:gap-4">
      <% @ads.each do |ad| %>
        <div class="tw:border tw:border-gray-200 tw:rounded-lg tw:p-3 tw:flex tw:flex-col tw:items-center tw:gap-3 <%= ad.active? ? "tw:bg-white" : "tw:bg-gray-100 tw:opacity-80" %>">
          <% if ad.image.attached? %>
            <%= image_tag ad.image.variant(resize_to_fill: [200, 100]), width: 200, height: 100, loading: "lazy", class: "reklam-bildo tw:rounded tw:max-w-full tw:h-auto" %>
          <% end %>

          <div class="tw:w-full tw:space-y-2 tw:text-xs">
            <p class="tw:m-0 tw:break-all tw:text-center">
              <%= link_to ad.url, ad.url, target: :_blank, rel: "noopener", class: "tw:text-brand-blue tw:hover:text-brand-blue-hover" %>
            </p>
            <div class="tw:flex tw:items-center tw:justify-between tw:pt-2 tw:border-t tw:border-gray-200">
              <% if ad.active? %>
                <%= link_to "Malebligi", admin_reklamoj_toggle_active_path(ad), class: "tw:text-amber-600 tw:hover:text-amber-700 tw:font-medium" %>
              <% else %>
                <%= link_to "Ebligi", admin_reklamoj_toggle_active_path(ad), class: "tw:text-esperanto-500 tw:hover:text-esperanto-600 tw:font-medium" %>
              <% end %>

              <%= link_to "Forviŝi", admin_reklamoj_url(ad), method: :delete, data: { confirm: "Ĉu vi certas?" }, class: "tw:text-brand-red tw:hover:text-brand-red-hover tw:font-medium" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

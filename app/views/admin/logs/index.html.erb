<%= render "admin/shared/breadcrumb", items: [["Logs"]] %>

<%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
  <% panel.with_body(class: "tw:space-y-4") do %>
    <h1 class="tw:text-xl tw:font-bold tw:text-gray-900 tw:pb-2 tw:border-b tw:border-gray-200 tw:m-0">Logs</h1>

    <%= form_with url: admin_logs_path, method: :get, local: true do %>
      <div class="tw:grid tw:grid-cols-1 tw:sm:grid-cols-2 tw:lg:grid-cols-12 tw:gap-2 tw:items-end">
        <div class="tw:lg:col-span-2">
          <%= render Ui::InputComponent.new(:start_date, id: "start_date", type: :date, size: :small, label: "EKDE", value: params[:start_date]) %>
        </div>
        <div class="tw:lg:col-span-2">
          <%= render Ui::InputComponent.new(:end_date, id: "end_date", type: :date, size: :small, label: "ĜIS", value: params[:end_date]) %>
        </div>
        <div class="tw:lg:col-span-3">
          <%= render Ui::InputComponent.new(:user_name, id: "user_name", size: :small, label: "UZANTO", value: params[:user_name], placeholder: "Serĉi uzanton...") %>
        </div>
        <div class="tw:lg:col-span-3">
          <%= render Ui::InputComponent.new(:text, id: "text", size: :small, label: "TEKSTO", value: params[:text], placeholder: "Serĉi tekston...") %>
        </div>
        <div class="tw:sm:col-span-2 tw:lg:col-span-2 tw:flex tw:items-center tw:gap-2">
          <%= render Ui::ButtonComponent.new("Filtri", type: :submit, variant: :success, size: :small) %>
          <%= render Ui::ButtonComponent.new("Nuligi", href: admin_logs_path, variant: :secondary, size: :small) %>
        </div>
      </div>
    <% end %>

    <div class="tw:border tw:border-gray-200 tw:rounded tw:overflow-hidden tw:text-xs">
      <div class="tw:grid tw:grid-cols-12 tw:gap-2 tw:items-center tw:bg-esperanto-500 tw:text-white tw:uppercase tw:font-bold tw:px-3 tw:py-2 tw:text-[11px]">
        <div class="tw:col-span-3 tw:md:col-span-2">Dato (UTC)</div>
        <div class="tw:col-span-3 tw:md:col-span-2">Uzanto</div>
        <div class="tw:col-span-4 tw:md:col-span-6">Teksto</div>
        <div class="tw:col-span-2">Agoj</div>
      </div>

      <% @logs.each_with_index do |log, i| %>
        <% stripe_classes = [
          ("tw:border-b tw:border-gray-200" unless i == @logs.size - 1),
          ("tw:bg-gray-50" if i.odd?)
        ].compact.join(" ") %>

        <div data-testid="log-entry" class="tw:grid tw:grid-cols-12 tw:gap-2 tw:items-center tw:px-3 tw:py-1.5 <%= stripe_classes %>">
          <div class="tw:col-span-3 tw:md:col-span-2 tw:font-semibold tw:text-esperanto-600 tw:break-words"><%= log.created_at.strftime("%d/%m/%Y %H:%M") %></div>
          <div class="tw:col-span-3 tw:md:col-span-2 tw:font-medium tw:text-gray-900 tw:truncate"><%= log.user&.name %></div>
          <div class="tw:col-span-4 tw:md:col-span-6 tw:text-gray-600 tw:break-words"><%= log.text %></div>
          <div class="tw:col-span-2 tw:flex tw:flex-wrap tw:gap-1">
            <% if log.event_id && (event = @events[log.event_id.to_i]) %>
              <%= render Ui::BadgeComponent.new("Evento", href: event_url(code: event.ligilo), variant: :secondary, shape: :rounded, size: :small, target: "_blank") %>
            <% end %>
            <% if log.organization_id && (org = @organizations[log.organization_id.to_i]) %>
              <%= render Ui::BadgeComponent.new("Organizo", href: organization_url(short_name: org.short_name), variant: :secondary, shape: :rounded, size: :small, target: "_blank") %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @logs.empty? %>
        <div class="tw:p-6 tw:text-center tw:text-gray-500">
          <%= icon("fas", "search", class: "fa-2x tw:mb-3 tw:opacity-25") %>
          <p class="tw:m-0">Neniu protokolo trovita.</p>
        </div>
      <% end %>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
<% end %>

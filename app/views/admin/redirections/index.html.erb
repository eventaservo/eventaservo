<%= render "admin/shared/breadcrumb", items: [["Redirektoj"]] %>

<%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
  <% panel.with_body(class: "tw:space-y-4") do %>
    <div class="tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-2 tw:pb-2 tw:border-b tw:border-gray-200">
      <h1 class="tw:text-xl tw:font-bold tw:text-gray-900 tw:m-0">Eventaj Redirektoj</h1>
      <%= render Ui::ButtonComponent.new("Nova Redirekto", href: new_admin_redirection_path, icon: "plus", variant: :new_link, size: :small) %>
    </div>

    <%= form_with url: admin_redirections_path, method: :get, local: true do %>
      <div class="tw:grid tw:grid-cols-1 tw:md:grid-cols-12 tw:gap-2 tw:items-end">
        <div class="tw:md:col-span-5">
          <%= render Ui::InputComponent.new(:old_url, id: "old_url", size: :small, label: "MALNOVA URL", value: params[:old_url], placeholder: "Serĉi malnovan URL...") %>
        </div>
        <div class="tw:md:col-span-4">
          <%= render Ui::InputComponent.new(:new_url, id: "new_url", size: :small, label: "NOVA URL", value: params[:new_url], placeholder: "Serĉi novan URL...") %>
        </div>
        <div class="tw:md:col-span-3 tw:flex tw:items-center tw:gap-2">
          <%= render Ui::ButtonComponent.new("Filtri", type: :submit, variant: :success, size: :small) %>
          <%= render Ui::ButtonComponent.new("Nuligi", href: admin_redirections_path, variant: :secondary, size: :small) %>
        </div>
      </div>
    <% end %>

    <div class="tw:border tw:border-gray-200 tw:rounded tw:overflow-hidden tw:text-xs">
      <div class="tw:grid tw:grid-cols-12 tw:gap-2 tw:items-center tw:bg-esperanto-500 tw:text-white tw:uppercase tw:font-bold tw:px-3 tw:py-2 tw:text-[11px]">
        <div class="tw:col-span-5">Malnova URL</div>
        <div class="tw:col-span-5">Nova URL</div>
        <div class="tw:col-span-2 tw:text-center">Hits</div>
      </div>

      <% @redirections.each_with_index do |redirection, i| %>
        <% stripe_classes = [
          ("tw:border-b tw:border-gray-200" unless i == @redirections.size - 1),
          ("tw:bg-gray-50" if i.odd?)
        ].compact.join(" ") %>

        <%= link_to edit_admin_redirection_path(redirection), class: "tw:grid tw:grid-cols-12 tw:gap-2 tw:items-center tw:px-3 tw:py-1.5 tw:text-gray-900 tw:no-underline tw:hover:bg-esperanto-50 tw:transition-colors #{stripe_classes}" do %>
          <div class="tw:col-span-5 tw:font-medium tw:text-gray-900 tw:break-all"><%= redirection.old_short_url %></div>
          <div class="tw:col-span-5 tw:text-gray-600 tw:break-all"><%= redirection.new_short_url %></div>
          <div class="tw:col-span-2 tw:text-center tw:text-gray-600"><%= redirection.hits %></div>
        <% end %>
      <% end %>

      <% if @redirections.empty? %>
        <div class="tw:p-6 tw:text-center tw:text-gray-500">
          <%= icon("fas", "search", class: "fa-2x tw:mb-3 tw:opacity-25") %>
          <p class="tw:m-0">Neniu redirekto trovita.</p>
        </div>
      <% end %>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
<% end %>

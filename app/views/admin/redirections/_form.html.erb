<%= form_with(model: redirection, url: redirection.new_record? ? admin_redirections_path : admin_redirection_path(redirection), local: true, class: "tw:space-y-4") do %>
  <%= error_handling(redirection) %>

  <%= render Ui::InputComponent.new(
    "event_redirection[old_short_url]",
    id: "event_redirection_old_short_url",
    label: "MALNOVA URL (SHORT CODE)",
    value: redirection.old_short_url,
    placeholder: "ekz: ijk2024",
    hint: "Tio estas kion la uzanto tajpas post la domajno."
  ) %>

  <%= render Ui::InputComponent.new(
    "event_redirection[new_short_url]",
    id: "event_redirection_new_short_url",
    label: "NOVA URL (SHORT CODE)",
    value: redirection.new_short_url,
    placeholder: "ekz: ijk2025",
    hint: "Tio estas la celo de la redirekto."
  ) %>

  <div class="tw:pt-3 tw:border-t tw:border-gray-200 tw:flex tw:flex-wrap tw:items-center tw:justify-end tw:gap-2">
    <% if redirection.persisted? %>
      <%= render Ui::ButtonComponent.new(
        "Forigi",
        href: admin_redirection_path(redirection),
        variant: :delete,
        class: "tw:mr-auto",
        data: { method: :delete, confirm: "Ĉu vi estas certa?" }
      ) %>
    <% end %>
    <%= render Ui::ButtonComponent.new("Nuligi", href: admin_redirections_path, variant: :cancel) %>
    <%= render Ui::ButtonComponent.new("Konservi", type: :submit, variant: :success) %>
  </div>
<% end %>

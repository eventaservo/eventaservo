<div class="box-white small text-center">
  <% if controller_name != 'sessions' %>
    <%= t("devise.shared.links.already_registered") %>
    <%= link_to t("devise.shared.links.sign_in"), new_session_path(resource_name), class: 'fw-bold' %>
    <br/>
  <% end %>
  <% if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= t("devise.shared.links.not_registered") %>
    <%= link_to t("devise.shared.links.sign_up_now"), new_registration_path(resource_name), class: 'fw-bold' %>
    <br/>
  <% end %>
  <% if devise_mapping.confirmable? && controller_name != 'confirmations' && controller_name != 'sessions' %>
    <br/>
    <%= link_to t("devise.shared.links.didnt_receive_confirmation_instructions"), new_confirmation_path(resource_name) %>
    <br/>
  <% end %>
</div>

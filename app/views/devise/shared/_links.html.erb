<%= render Ui::CardComponent.new(variant: :bordered, class: "tw:mt-3") do |panel| %>
  <% panel.with_body(class: "tw:text-xs tw:text-center tw:space-y-1") do %>
    <% if controller_name != "sessions" %>
      <div>
        <%= t("devise.shared.links.already_registered") %>
        <%= link_to t("devise.shared.links.sign_in"), new_session_path(resource_name), class: "tw:font-bold" %>
      </div>
    <% end %>
    <% if devise_mapping.registerable? && controller_name != "registrations" %>
      <div>
        <%= t("devise.shared.links.not_registered") %>
        <%= link_to t("devise.shared.links.sign_up_now"), new_registration_path(resource_name), class: "tw:font-bold" %>
      </div>
    <% end %>
    <% if devise_mapping.confirmable? && controller_name != "confirmations" && controller_name != "sessions" %>
      <div class="tw:pt-1">
        <%= link_to t("devise.shared.links.didnt_receive_confirmation_instructions"), new_confirmation_path(resource_name) %>
      </div>
    <% end %>
  <% end %>
<% end %>

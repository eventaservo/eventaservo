<div class="col-12 col-lg-4 offset-lg-4 col-sm-8 offset-sm-2">
  <div class="box-white">
    <div class="text-center">
      <h3>Eventa Servo</h3>
      <p class="fg-color-grayDark fw-bold">
        <%= t("devise.passwords.new.subtitle") %>
      </p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>

      <%= error_handling(resource) %>

      <div class="mb-3">
        <p class="small"><%= t("devise.passwords.new.instructions") %></p>
        <%= f.email_field :email, autocomplete: 'email', class: 'form-control', autofocus: true, placeholder: t("activerecord.attributes.user.email") %>
      </div>
      <%= f.submit t("devise.passwords.new.submit"), class: 'button-submit col-12' %>
    <% end %>
  </div>

  <%= render partial: 'devise/shared/links' %>
</div>

<div class="tw:max-w-md tw:mx-auto tw:my-4">
  <%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
    <% panel.with_body(class: "tw:space-y-4") do %>
      <div class="tw:text-center">
        <h3 class="tw:text-2xl tw:font-medium tw:text-gray-900 tw:m-0">Eventa Servo</h3>
        <p class="tw:text-sm tw:font-bold tw:text-gray-600 tw:mt-1 tw:mb-0">
          <%= t("devise.passwords.new.subtitle") %>
        </p>
      </div>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: {method: :post, class: "tw:space-y-3"}) do |f| %>
        <%= error_handling(resource) %>

        <div class="tw:space-y-2">
          <p class="tw:text-xs tw:text-gray-600 tw:m-0"><%= t("devise.passwords.new.instructions") %></p>
          <%= render Ui::InputComponent.new(f.field_name(:email), id: f.field_id(:email), type: :email, value: resource.email, autocomplete: "email", autofocus: true, placeholder: t("activerecord.attributes.user.email")) %>
        </div>

        <%= f.submit t("devise.passwords.new.submit"),
              class: "tw:w-full tw:inline-flex tw:items-center tw:justify-center tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium tw:text-white tw:bg-brand-blue tw:hover:bg-brand-blue-hover tw:rounded tw:border tw:border-brand-blue tw:cursor-pointer tw:transition-colors" %>
      <% end %>
    <% end %>
  <% end %>

  <%= render partial: "devise/shared/links" %>
</div>

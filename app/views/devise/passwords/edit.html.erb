<div class="col-lg-6 offset-lg-3">
  <div class="box-white">
    <div class="lead"><%= t("devise.passwords.edit.title") %></div>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="mb-3">
        <%= f.label :password, t("devise.passwords.edit.new_password") %>
        <%= f.password_field :password, autofocus: true, autocomplete: 'new-password', class: 'form-control', aria: { describedby: "password-help" } %>
        <small class="form-text text-muted" id="password-help"><%= t("devise.passwords.edit.minimum_characters", count: 6) %></small>
      </div>
      <div class="mb-3">
        <%= f.label :password_confirmation, t("devise.passwords.edit.password_confirmation") %>
        <%= f.password_field :password_confirmation, autocomplete: 'off', class: 'form-control' %>
      </div>

      <div class="buttons-footer">
        <%= f.submit t("devise.passwords.edit.submit"), class: 'button-submit' %>
      </div>
    <% end %>
  </div>
</div>

<div class="tw:max-w-md tw:mx-auto tw:my-4">
  <%= render Ui::CardComponent.new(variant: :bordered) do |panel| %>
    <% panel.with_body(class: "tw:space-y-4") do %>
      <div class="tw:text-center">
        <h3 class="tw:text-2xl tw:font-medium tw:text-gray-900 tw:m-0">Eventa Servo</h3>
        <p class="tw:text-sm tw:font-bold tw:text-gray-600 tw:mt-1 tw:mb-0"><%= t("devise.sessions.new.subtitle") %></p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: {class: "tw:space-y-3", data: {turbo: false}}) do |f| %>
        <%= render Ui::InputComponent.new(f.field_name(:email), id: f.field_id(:email), type: :email, value: resource.email, autocomplete: "email", autofocus: true, placeholder: t("activerecord.attributes.user.email")) %>

        <div>
          <%= render Ui::InputComponent.new(f.field_name(:password), id: f.field_id(:password), type: :password, autocomplete: "current-password", placeholder: t("activerecord.attributes.user.password")) %>
          <div class="tw:text-end tw:mt-1">
            <%= link_to t("devise.sessions.new.forgot_password"), new_password_path(resource_name), class: "tw:text-xs" %>
          </div>
        </div>

        <%= f.submit t("devise.sessions.new.submit"),
              class: "tw:w-full tw:inline-flex tw:items-center tw:justify-center tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium tw:text-white tw:bg-brand-blue tw:hover:bg-brand-blue-hover tw:rounded tw:border tw:border-brand-blue tw:cursor-pointer tw:transition-colors" %>
      <% end %>

      <div class="text-divider tw:font-bold tw:text-gray-600"><%= t("common.or_upper") %></div>

      <div class="tw:space-y-1.5">
        <%= button_to user_google_oauth2_omniauth_authorize_path,
              form: {data: {turbo: false}},
              class: "tw:w-full tw:inline-flex tw:items-center tw:justify-center tw:gap-1.5 tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium tw:bg-white tw:hover:bg-gray-50 tw:text-gray-800 tw:border tw:border-gray-300 tw:rounded tw:cursor-pointer tw:transition-colors" do %>
          <i class="fab fa-google" aria-hidden="true"></i>
          <span><%= t("devise.shared.sign_in_with_provider", provider: "Google") %></span>
        <% end %>

        <%= button_to user_facebook_omniauth_authorize_path,
              form: {data: {turbo: false}},
              class: "tw:w-full tw:inline-flex tw:items-center tw:justify-center tw:gap-1.5 tw:px-3 tw:py-1.5 tw:text-sm tw:font-medium tw:bg-[#4260B4] tw:hover:bg-[#38529a] tw:text-white tw:border tw:border-[#4260B4] tw:rounded tw:cursor-pointer tw:transition-colors" do %>
          <i class="fab fa-facebook" aria-hidden="true"></i>
          <span><%= t("devise.shared.sign_in_with_provider", provider: "Facebook") %></span>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= render partial: "devise/shared/links" %>
</div>

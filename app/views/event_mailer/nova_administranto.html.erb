<br>
<table>
  <tbody>
    <tr>
      <td class="content" colspan="2">
        <p>
          <%= t("event_mailer.nova_administranto.greeting", name: @evento.user.name) %>
        </p>

        <p>
          <%= t("event_mailer.nova_administranto.body_html",
                event_link: link_to(@evento.title, event_url(code: @evento.ligilo))) %>
        </p>

        <p>
          <%= t("event_mailer.nova_administranto.invitation") %>
        </p>

        <p><%= t("event_mailer.nova_administranto.closing") %></p>
        <p class="button-blue text-center">
          <%= link_to t("event_mailer.nova_administranto.view_event_page"), event_url(code: @evento.ligilo) %>
        </p>
      </td>
    </tr>

    <%= render 'email_footer' %>
  </tbody>
</table>

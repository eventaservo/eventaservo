<div class="header">
  <%= link_to 'https://eventaservo.org', class: 'links' do %>
    <h1>Eventa Servo</h1>
  <% end %>
</div>

<h3 class="text-center">
  <%= t("event_mailer.weekly_summary.events_taking_place_between") %><br>
  <%= event_date(Event.new(date_start: Time.zone.today, date_end: Time.zone.today + 7.days)).gsub(' - ', " #{t('event_mailer.weekly_summary.and')} ") %>
</h3>

<% if @events.empty? %>
  <%= render partial: 'no_events' %>
<% else %>
  <%= render partial: 'event_list' %>
<% end %>

<br>

<div class="text-center">
  <div class="button-blue">
    <%= link_to t("event_mailer.weekly_summary.share_my_event"), new_event_url %>
  </div>
</div>

<br>

<div class="text-center small">
  <br>
  <%= t("event_mailer.weekly_summary.unsubscribe_html", link: link_to(t("event_mailer.weekly_summary.unsubscribe"), edit_user_registration_url)) %>
</div>

<br>
<table>
  <tbody>
    <tr>
      <td class="content" colspan="2">
        <p>
          <%= t("event_mailer.rememorigas_uzantojn.greeting") %>
        </p>
        <p>
          <%= t("event_mailer.rememorigas_uzantojn.interest_html",
                site_link: link_to("Eventa Servo", "https://eventaservo.org"),
                event_link: link_to(@event.title, event_url(code: @event.ligilo))) %>
        </p>
        <p><%= @reminder_message %></p>

        <p class="button-blue text-center">
          <%= link_to t("event_mailer.rememorigas_uzantojn.view_event_page"), event_url(code: @event.ligilo) %>
        </p>

        <br>
        <p style="font-size: small; color: gray;">
          <%= t("event_mailer.rememorigas_uzantojn.footer_note_html",
                site_link: link_to("Eventa Servo", "https://eventaservo.org"),
                button_name: t("events.participants.interested_button")) %>
        </p>
        <br>
      </td>
    </tr>
    <%= render 'email_footer' %>
  </tbody>
</table>

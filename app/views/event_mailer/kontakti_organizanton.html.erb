<br>
<table>
  <tbody>
    <tr>
      <td class="content" colspan="2">
        <p>
          <%= t("event_mailer.kontakti_organizanton.greeting") %>
        </p>

        <p>
          <%= t("event_mailer.kontakti_organizanton.body_html",
                event_link: link_to(@event.title, event_url(code: @event.ligilo))) %>
        </p>

        <p>
          <%= t("event_mailer.kontakti_organizanton.message_intro") %>
        </p>

        <p class="block-quote">
          "<%= @message %>" - <i><%= @user.name %></i>
        </p>
      </td>
    </tr>

    <%= render 'email_footer' %>
  </tbody>
</table>

<%- if Rails.application.credentials.dig(:sentry, :dsn) %>
  <script
    src="https://browser.sentry-cdn.com/7.113.0/bundle.tracing.replay.min.js"
    integrity="sha384-wXgzLdc+RJ2eAiFpbvC5qUGzPUApNnMOI/DBvb1hSu8Zo4J/7NkxmP4DvBmNvWbQ"
    crossorigin="anonymous">
  </script>

  <script>
    if (!window.__SENTRY_INITIALIZED) {
      Sentry.init({
        dsn: "<%= Rails.application.credentials.dig(:sentry, :dsn) %>",
        replaysSessionSampleRate: 0.1,
        replaysOnErrorSampleRate: 1.0,
        environment: "<%= Rails.env %>",
        release: "<%= Eventaservo::Application::VERSION %>",
        beforeSend: function (event) {
          // Turbo Drive (v7.3+) aborts a navigation with an AbortError
          // (DOMException code 20) whenever a visit is superseded by another
          // one or the page is left mid-request. This is the framework's
          // intentional cancellation of an in-flight request, not an app
          // crash, so it would otherwise pollute the issue tracker. Keep every
          // other error.
          var values = event && event.exception && event.exception.values;
          var isTurboCancellation =
            values &&
            values.some(function (exc) {
              return (
                exc &&
                exc.mechanism &&
                exc.mechanism.type === "onunhandledrejection" &&
                exc.mechanism.handled === false &&
                exc.type === "AbortError"
              );
            });
          return isTurboCancellation ? null : event;
        },
        integrations: [
          Sentry.replayIntegration({
            maskAllText: false,
            maskAllInputs: false,
            blockAllMedia: false,
          }),
        ],
      });

      window.__SENTRY_INITIALIZED = true;
    }

    <%- if @current_user %>
      Sentry.setUser(
        {
          username: '<%= @current_user.name %>',
          email: '<%= @current_user.email %>'
        }
      )
    <% end %>
  </script>
<% end %>

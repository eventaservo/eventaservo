<nav class="navbar navbar-expand-lg navbar-dark bg-success"
     data-controller="toggle"
     data-toggle-active-class-value="show"
     data-toggle-close-on-esc-value="true"
     data-toggle-close-on-click-outside-value="true">
  <div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between flex-grow-1 flex-lg-grow-0 me-lg-3 flex-nowrap" style="min-width: 0;">
      <div class="d-flex align-items-center flex-nowrap flex-shrink-1 me-2" style="min-width: 0;">
        <%= link_to(root_url, class: "navbar-brand me-2 flex-shrink-0") do %>
          <% if Rails.env.production? %>
            Eventa Servo
          <% else %>
            <span class="small"><%= Rails.env.upcase %></span>
          <% end %>
        <% end %>

        <%= render partial: "layouts/navbar_search" %>
      </div>

      <button type="button"
              class="navbar-toggler flex-shrink-0 ms-auto"
              data-toggle-target="button"
              data-action="toggle#toggle"
              aria-controls="navbar-supported-content"
              aria-expanded="false"
              aria-label="<%= t('navbar.toggle_navigation') %>">
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>

    <div class="collapse navbar-collapse justify-content-between text-end text-lg-start"
         id="navbar-supported-content"
         data-toggle-target="content">
      <ul class="navbar-nav ms-auto mx-lg-auto align-items-end align-items-lg-center text-end text-lg-start">
        <li class="nav-item">
          <%= link_to(new_event_path, class: "nav-link text-end text-lg-start") do %>
            <%= icon("fas", "calendar-plus") %>
            <%= t("navbar.add_event") %>
          <% end %>
        </li>
        <li class="nav-item">
          <%= link_to(organizations_url, class: "nav-link text-end text-lg-start") do %>
            <%= icon("fas", "building") %>
            <%= t("navbar.organizations") %>
          <% end %>
        </li>
      </ul>

      <ul class="navbar-nav align-items-end align-items-lg-center justify-content-end">
        <%= render "layouts/navbar_tools" %>
      </ul>

      <%= render partial: "layouts/uzanto" %>
    </div>
  </div>
</nav>

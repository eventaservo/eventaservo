<% link_classes = "tw:inline-flex tw:items-center tw:gap-1.5 tw:px-2 tw:py-1.5 tw:text-sm tw:text-white/85 tw:hover:text-white tw:no-underline" %>
<% if cookies[:vidmaniero] == "mapo" %>
  <li class="tw:hidden tw:lg:block">
    <%= link_to view_style_url("kalendaro"), class: link_classes,
      aria: { label: t("navbar.tools.close_map") },
      data: { controller: "hint", hint_text_value: t("navbar.tools.close_map"), hint_placement_value: "bottom" } do %>
      <i class="fas fa-map-marker-alt tw:text-yellow-300" aria-hidden="true"></i>
    <% end %>
  </li>
  <li class="tw:block tw:lg:hidden">
    <%= link_to icon("fas", "map-marker-alt", t("navbar.tools.close_map"), class: "tw:text-yellow-300"), view_style_url("kalendaro"), class: link_classes %>
  </li>
<% else %>
  <li class="tw:hidden tw:lg:block">
    <%= link_to view_style_url("mapo"), class: link_classes,
      aria: { label: t("navbar.tools.view_as_map") },
      data: { controller: "hint", hint_text_value: t("navbar.tools.view_as_map"), hint_placement_value: "bottom" } do %>
      <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
    <% end %>
  </li>
  <li class="tw:block tw:lg:hidden">
    <%= link_to icon("fas", "map-marker-alt", t("navbar.tools.view_as_map")), view_style_url("mapo"), class: link_classes %>
  </li>
<% end %>
<li class="tw:hidden tw:lg:block">
  <%= link_to "https://nevelsteen.info/instigo/", target: "_blank", rel: "noopener", class: link_classes,
    aria: { label: t("navbar.tools.support") },
    data: { controller: "hint", hint_text_value: t("navbar.tools.support"), hint_placement_value: "bottom" } do %>
    <i class="fas fa-heart" aria-hidden="true"></i>
  <% end %>
</li>
<li class="tw:block tw:lg:hidden">
  <%= link_to icon("fas", "heart", t("navbar.tools.support")), "https://nevelsteen.info/instigo/", target: "_blank", rel: "noopener", class: link_classes %>
</li>
<li class="tw:hidden tw:lg:block">
  <%= link_to "https://t.me/s/eventaservo", target: "_blank", rel: "noopener", class: link_classes,
    aria: { label: t("navbar.tools.news") },
    data: { controller: "hint", hint_text_value: t("navbar.tools.news"), hint_placement_value: "bottom" } do %>
    <i class="fas fa-newspaper" aria-hidden="true"></i>
  <% end %>
</li>
<li class="tw:block tw:lg:hidden">
  <%= link_to icon("fas", "newspaper", t("navbar.tools.news")), "https://t.me/s/eventaservo", target: "_blank", rel: "noopener", class: link_classes %>
</li>
<li class="tw:hidden tw:lg:block">
  <%= link_to prie_url, class: link_classes,
    aria: { label: t("navbar.tools.about_us") },
    data: { controller: "hint", hint_text_value: t("navbar.tools.about_us"), hint_placement_value: "bottom" } do %>
    <i class="fas fa-user-friends" aria-hidden="true"></i>
  <% end %>
</li>
<li class="tw:block tw:lg:hidden">
  <%= link_to icon("fas", "user-friends", t("navbar.tools.about_us")), prie_url, class: link_classes %>
</li>
<%= render "layouts/navbar/language_selector" if user_signed_in? && current_user.admin? %>
<%= render partial: "layouts/admin" if user_signed_in? && current_user.admin? %>

<ul class="navbar-nav">
  <% if user_signed_in? %>
    <li class="nav-item dropdown active">
      <a id="uzantoDropdown" class="nav-link dropdown-toggle" aria-expanded="false" aria-haspopup="true" data-bs-toggle="dropdown" href="#" role="button">
        <%= display_user(current_user) %>
      </a>
      <div class="dropdown-menu dropdown-menu-end" aria-labelledby="uzantoDropdown">
        <%= link_to icon('fa-solid', 'user', t('navbar.user.my_profile')), events_by_username_path(current_user.username), class: 'dropdown-item' %>
        <%= link_to icon('fa-regular', 'calendar', t('navbar.user.my_events')), user_events_path(current_user.username), class: 'dropdown-item' %>
        <div class="dropdown-divider"></div>
        <%= link_to icon('fa-solid', 'user-edit', t('navbar.user.edit_profile')), edit_user_registration_path, class: 'dropdown-item' %>
        <div class="dropdown-divider"></div>
        <%= link_to icon('fa-solid', 'sign-out-alt', t('navbar.user.sign_out')), destroy_user_session_path, class: 'dropdown-item', method: :delete %>
      </div>
    </li>
  <% else %>
    <li class="nav-item">
      <%= link_to icon('fa-solid', 'sign-in-alt', t('navbar.log_in_sign_up')), new_user_session_path, class: 'btn btn-sm btn-outline-light' %>
    </li>
  <% end %>
</ul>

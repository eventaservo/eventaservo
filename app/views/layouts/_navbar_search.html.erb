<form class="d-flex flex-shrink-1" style="min-width: 0;" data-controller="search" data-search-url-value="<%= serchilo_path %>">
  <input
    class="form-control me-2"
    style="min-width: 0; max-width: 220px;"
    type="search"
    placeholder="<%= t('navbar.search.placeholder') %>"
    aria-label="<%= t('navbar.search.aria_label') %>"
    data-search-target="searchTerm"
    data-action="keyup->search#goToSearchPage"
    >
</form>

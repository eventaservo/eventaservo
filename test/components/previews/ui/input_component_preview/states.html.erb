<div class="tw:p-6 tw:max-w-md tw:space-y-4">
  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Padrão / Normal</h3>
    <%= render Ui::InputComponent.new(
      :standard,
      label: "Normala Kampo",
      placeholder: "Skribu ion ĉi tie...",
      hint: "Ĉi tiu kampo estas en normala stato."
    ) %>
  </div>

  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Com Erro de Validação</h3>
    <%= render Ui::InputComponent.new(
      :with_error,
      label: "Retpoŝto",
      value: "malvalida-retposhto",
      error: "La retpoŝtadreso ne estas valida formato."
    ) %>
  </div>

  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Desabilitado (Disabled)</h3>
    <%= render Ui::InputComponent.new(
      :disabled_field,
      label: "Neaktiva Kampo",
      value: "Ĉi tiu valoro ne estas redaktebla",
      disabled: true,
      hint: "Vi ne havas permeson ŝanĝi ĉi tiun valoron."
    ) %>
  </div>

  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Somente Leitura (Readonly)</h3>
    <%= render Ui::InputComponent.new(
      :readonly_field,
      label: "Nurlega Kampo",
      value: "SISTEMA-ID-99482",
      readonly: true,
      hint: "Generita aŭtomate de la sistemo."
    ) %>
  </div>
</div>

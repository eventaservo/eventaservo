<div class="tw:p-8 tw:max-w-6xl tw:mx-auto tw:space-y-10">
  <div>
    <h2 class="tw:text-2xl tw:font-bold tw:text-gray-900 tw:tracking-tight">Eventa Servo Kolorpaletro</h2>
    <p class="tw:text-sm tw:text-gray-600 tw:mt-1">
      Oficialaj koloroj kaj CSS-variabloj de la dezajna sistemo (Tailwind CSS v4 & Sass-heredaĵo).
    </p>
  </div>

  <%# 1. Esperanto Heritage Green %>
  <div class="tw:space-y-3">
    <div class="tw:border-b tw:border-gray-200 tw:pb-2">
      <h3 class="tw:text-base tw:font-bold tw:text-gray-900">1. Esperanto-Verdo (Ĉefa Marka Identeco)</h3>
      <p class="tw:text-xs tw:text-gray-500">Uzata por logoo, primaraj kreaj butonoj (.button-new), aktivaj elementoj kaj sukcesaj statoj.</p>
    </div>
    <div class="tw:grid tw:grid-cols-2 sm:tw:grid-cols-3 md:tw:grid-cols-5 tw:gap-4">
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:border tw:border-gray-200 tw:mb-2 tw:bg-[#f7faf7]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">esperanto-50</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#f7faf7</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Fona verda nuanco</div>
      </div>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:border tw:border-gray-200 tw:mb-2 tw:bg-[#e5f4e8]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">esperanto-100</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#e5f4e8</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Sukcesa insigno-fono</div>
      </div>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:mb-2 tw:bg-[#28a745]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">esperanto-500</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#28a745 ($esperantoGreen)</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Oficiala verda ĉefbutono</div>
      </div>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:mb-2 tw:bg-[#1e7145]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">esperanto-600</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#1e7145 ($greenDark)</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Verda ŝveba stato</div>
      </div>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:mb-2 tw:bg-[#202c23]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">esperanto-900</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#202c23</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Malhela arbara teksto</div>
      </div>
    </div>
  </div>

  <%# 2. Event Timing Colors %>
  <div class="tw:space-y-3">
    <div class="tw:border-b tw:border-gray-200 tw:pb-2">
      <h3 class="tw:text-base tw:font-bold tw:text-gray-900">2. Eventa Kronologia Vivciklo (Timing Colors)</h3>
      <p class="tw:text-xs tw:text-gray-500">Uzata por la maldekstra vertikala bordero de eventaj kartoj laŭ dato.</p>
    </div>
    <div class="tw:grid tw:grid-cols-2 sm:tw:grid-cols-3 md:tw:grid-cols-5 tw:gap-4">
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:mb-2 tw:bg-[#00a300]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">Hodiaŭ (Today)</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#00a300 ($evento-hodiaua)</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Okazanta hodiaŭ</div>
      </div>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:mb-2 tw:bg-[#e3a21a]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">7 Tagoj</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#e3a21a ($evento-p7_tagojn)</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">En la venontaj 7 tagoj</div>
      </div>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:mb-2 tw:bg-[#ffc40d]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">30 Tagoj</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#ffc40d ($evento-p30_tagojn)</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">En la venontaj 30 tagoj</div>
      </div>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:mb-2 tw:bg-[#2d89ef]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">Estontece (Future)</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#2d89ef ($evento-estontece)</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Pli ol 30 tagoj</div>
      </div>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:mb-2 tw:bg-[#c0c0c0]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">Pasinta (Past)</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#c0c0c0 ($evento-pasinta)</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Jam okazinta evento</div>
      </div>
    </div>
  </div>

  <%# 3. Brand Blue, Info & Feedback %>
  <div class="tw:space-y-3">
    <div class="tw:border-b tw:border-gray-200 tw:pb-2">
      <h3 class="tw:text-base tw:font-bold tw:text-gray-900">3. Brand Blue, Info & Reagoj (Actions & Badges)</h3>
      <p class="tw:text-xs tw:text-gray-500">Uzata por konservaj butonoj, kategorioj, forigoj kaj avertaj karakterizoj.</p>
    </div>
    <div class="tw:grid tw:grid-cols-2 sm:tw:grid-cols-3 md:tw:grid-cols-4 tw:gap-4">
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:mb-2 tw:bg-[#2d89ef]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">Brand Blue ($blue)</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#2d89ef</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Konservi / Submit butono</div>
      </div>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:mb-2 tw:bg-[#17a2b8]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">Info Teal ($info)</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#17a2b8</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Kategoriaj insignoj & aktivaj filtroj</div>
      </div>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:mb-2 tw:bg-[#b91d47]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">Brand Red ($red)</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#b91d47</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Forigi / Danger butonoj & eraroj</div>
      </div>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:mb-2 tw:bg-[#ffc107]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">Warning Amber</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#ffc107</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Karakterizaj insignoj</div>
      </div>
    </div>
  </div>

  <%# 4. Neutrals & Surfaces %>
  <div class="tw:space-y-3">
    <div class="tw:border-b tw:border-gray-200 tw:pb-2">
      <h3 class="tw:text-base tw:font-bold tw:text-gray-900">4. Neŭtralaj Surfacoj & Tekstoj (Neutrals)</h3>
      <p class="tw:text-xs tw:text-gray-500">Uzata por fonoj, borderoj, neaktivaj statoj kaj tekstoj.</p>
    </div>
    <div class="tw:grid tw:grid-cols-2 sm:tw:grid-cols-3 md:tw:grid-cols-4 tw:gap-4">
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:border tw:border-gray-200 tw:mb-2 tw:bg-[#ffffff]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">Blanko (White)</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#ffffff</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Karto & formulara fono (.box-white)</div>
      </div>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:border tw:border-gray-200 tw:mb-2 tw:bg-[#f7f7f7]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">Gray Lighter</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#f7f7f7</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Paĝa fono</div>
      </div>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:mb-2 tw:bg-[#999999]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">Gray Dark ($grayDark)</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#999999</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Nuligi-butono & sekundara teksto</div>
      </div>
      <div class="tw:border tw:border-gray-200 tw:rounded tw:p-3 tw:bg-white tw:shadow-sm">
        <div class="tw:h-16 tw:rounded tw:mb-2 tw:bg-[#1d1d1d]"></div>
        <div class="tw:text-xs tw:font-bold tw:text-gray-900">Darken</div>
        <div class="tw:text-[11px] tw:text-gray-500 tw:font-mono">#1d1d1d</div>
        <div class="tw:text-[10px] tw:text-gray-500 tw:mt-1">Ĉefa teksta koloro</div>
      </div>
    </div>
  </div>
</div>

<div class="tw:flex tw:items-center tw:justify-center tw:gap-8 tw:p-16 tw:text-lg tw:text-gray-700">
  <%= render Ui::TooltipComponent.new(text: "Montri kiel mapon", placement: :bottom) do %>
    <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
  <% end %>

  <%= render Ui::TooltipComponent.new(text: "Somertempo", placement: :top) do %>

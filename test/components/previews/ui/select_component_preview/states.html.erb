<div class="tw:p-6 tw:max-w-md tw:space-y-4">
  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Padrão / Normal</h3>
    <%= render Ui::SelectComponent.new(
      :language,
      label: "Ĉefa Lingvo",
      include_blank: "Elektu lingvon...",
      options: ["Esperanto", "Angla", "Franca", "Hispana", "Portugala"],
      selected: "Esperanto"
    ) %>
  </div>

  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Com Erro de Validação</h3>
    <%= render Ui::SelectComponent.new(
      :country_error,
      label: "Lando",
      include_blank: "Elektu landon...",
      options: ["Brazilo", "Francio", "Germanio"],
      error: "Bonvolu elekti validan landon el la listo."
    ) %>
  </div>

  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Desabilitado (Disabled)</h3>
    <%= render Ui::SelectComponent.new(
      :continent_disabled,
      label: "Kontinento",
      options: ["Eŭropo"],
      selected: "Eŭropo",
      disabled: true,
      hint: "Determinite aŭtomate laŭ la elektita urbo."
    ) %>
  </div>
</div>

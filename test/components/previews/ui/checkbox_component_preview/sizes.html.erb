<div class="tw:p-6 tw:max-w-md tw:space-y-6">
  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Small (:small) — Compacto</h3>
    <%= render Ui::CheckboxComponent.new(
      :filter_active,
      label: "Nur aktivaj eventoj",
      size: :small,
      checked: true
    ) %>
  </div>

  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Medium (:medium) — Padrão</h3>
    <%= render Ui::CheckboxComponent.new(
      :accept_terms,
      label: "Mi akceptas la uzkondiĉojn kaj privatecpolitikon",
      size: :medium,
      checked: true
    ) %>
  </div>
</div>

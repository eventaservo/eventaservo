<div class="tw:p-6 tw:max-w-2xl tw:space-y-4">
  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Info kun ikono</h3>
    <%= render Ui::AlertComponent.new(
      "Por vidi eventojn en via urbo, elektu la urbon en la serĉilo.",
      variant: :info,
      icon: true
    ) %>
  </div>

  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Primary / Notice kun ikono</h3>
    <%= render Ui::AlertComponent.new(
      "Via sesio finiĝos post 15 minutoj pro neaktiveco.",
      variant: :primary,
      icon: true
    ) %>
  </div>

  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Sukceso kun ikono</h3>
    <%= render Ui::AlertComponent.new(
      "Dankon! Via aliĝo al la evento estas konfirmita.",
      variant: :success,
      icon: true
    ) %>
  </div>

  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Averto kun ikono</h3>
    <%= render Ui::AlertComponent.new(
      "Atentu: Restas nur 3 liberaj lokoj por tiu ĉi seminario.",
      variant: :warning,
      icon: true
    ) %>
  </div>

  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Eraro kun ikono</h3>
    <%= render Ui::AlertComponent.new(
      "Ne eblis konektiĝi al la servilo. Bonvolu reprovi post kelkaj momentoj.",
      variant: :danger,
      icon: true
    ) %>
  </div>

  <div>
    <h3 class="tw:text-sm tw:font-semibold tw:text-gray-500 tw:uppercase tw:tracking-wider tw:mb-2">Propra ikono (bell)</h3>
    <%= render Ui::AlertComponent.new(
      "Vi havas novajn nelegitajn sciigojn en via profilo.",
      variant: :secondary,
      icon: "bell"
    ) %>
  </div>
</div>

<div class="tw:space-y-6">
  <%= render Ui::NavbarComponent.new do |nav| %>
    <% nav.with_brand(title: "Eventa Servo") %>
    <% nav.with_search %>

    <% nav.with_item("Aldoni eventon", href: "/events/new", icon: "calendar-plus") %>
    <% nav.with_item("Organizaĵoj", href: "/organizations", icon: "building") %>

    <% nav.with_tool(icon: "map-marker-alt", href: "/?vidmaniero=kalendaro", label: "Fermi mapon", active: true) %>
    <% nav.with_tool(icon: "newspaper", href: "https://t.me/s/eventaservo", label: "Telegram Novaĵoj", target: "_blank") %>
    <% nav.with_tool(icon: "heart", href: "https://nevelsteen.info/instigo/", label: "Subteni", target: "_blank") %>
    <% nav.with_tool(icon: "user-friends", href: "/prie", label: "Pri ni") %>

    <% nav.with_user_menu do %>
      <%= render Ui::ButtonComponent.new(
            "Ensaluti",
            href: "/users/sign_in",
            variant: :secondary,
            size: :small,
            class: "tw:!text-white tw:!border-white/40 hover:tw:!bg-white/15"
          ) %>
    <% end %>
  <% end %>
</div>
